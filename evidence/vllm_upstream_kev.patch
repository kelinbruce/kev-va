@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: Apache-2.0
+from .protocol import Limits
+
+
+def validate_runtime(config, limits: Limits) -> None:
+    model = config.model_config
+    parallel = config.parallel_config
+    forbidden = {
+        "tensor_parallel_size": parallel.tensor_parallel_size != 1,
+        "pipeline_parallel_size": parallel.pipeline_parallel_size != 1,
+        "data_parallel_size": parallel.data_parallel_size != 1,
+        "graph execution": not model.enforce_eager,
+        "quantization": model.quantization is not None,
+        "dynamic LoRA": config.lora_config is not None,
+        "prefix caching": config.cache_config.enable_prefix_caching,
+        "chunked prefill": config.scheduler_config.enable_chunked_prefill,
+        "speculative decoding": config.speculative_config is not None,
+        "non-causal attention": model.attn_type != "decoder"
+        or not getattr(model.hf_config, "is_causal", True),
+    }
+    if any(forbidden.values()):
+        raise ValueError(
+            "unsupported KEV configuration: "
+            + ", ".join(k for k, v in forbidden.items() if v)
+        )
+    dtype = str(model.dtype).removeprefix("torch.")
+    expected = model.hf_config.kev_backbone_dtype
+    if dtype not in ("bfloat16", "float16", "float32") or dtype != expected:
+        raise ValueError(f"KEV dtype must explicitly match artifact: {expected}")
+    if config.scheduler_config.max_num_batched_tokens < limits.branch_tokens:
+        raise ValueError(
+            "max_num_batched_tokens is smaller than the longest KEV branch"
+        )
+    if model.max_model_len < limits.branch_tokens:
+        raise ValueError("max_model_len is smaller than the longest KEV branch")
+    if config.scheduler_config.max_num_seqs < limits.children:
+        raise ValueError("max_num_seqs is smaller than global KEV child capacity")
diff --git a/vllm/entrypoints/pooling/systemone/serving.py b/vllm/entrypoints/pooling/systemone/serving.py
new file mode 100644
index 000000000..cec4f12ce
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/serving.py
@@ -0,0 +1,230 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded, round-robin parent/child scheduling for decision-only serving."""
+
+import asyncio
+import time
+import uuid
+from collections import deque
+from dataclasses import dataclass, field
+
+from .protocol import (
+    Limits,
+    PreparedRequest,
+    SystemOneRequest,
+    answer,
+    output_tokens,
+    prepare,
+)
+
+
+class DecisionError(Exception):
+    def __init__(self, status: int, message: str, code: str):
+        super().__init__(message)
+        self.status = status
+        self.code = code
+
+    def response(self):
+        return {
+            "error": {
+                "message": str(self),
+                "type": "systemone_error",
+                "code": self.code,
+                "param": None,
+            }
+        }
+
+
+@dataclass(eq=False)
+class Parent:
+    prepared: PreparedRequest
+    future: asyncio.Future
+    request_id: str = field(default_factory=lambda: "kev-" + uuid.uuid4().hex)
+    next_index: int = 0
+    running: dict = field(default_factory=dict)
+    results: dict = field(default_factory=dict)
+    submitted_at: float = field(default_factory=time.monotonic)
+    started_at: float | None = None
+    closed: bool = False
+
+
+class DecisionService:
+    def __init__(
+        self,
+        backend,
+        tokenizer,
+        model_id: str,
+        limits: Limits | None = None,
+        metrics=None,
+    ):
+        self.backend = backend
+        self.tokenizer = tokenizer
+        self.model_id = model_id
+        self.limits = limits or Limits()
+        self.metrics = metrics
+        self.ready = False
+        self.parents: deque[Parent] = deque()
+        self.inflight = 0
+        self.wakeup = asyncio.Event()
+        self.dispatcher = None
+
+    def metric(self, name, value=1):
+        if self.metrics:
+            self.metrics(name, value)
+
+    async def start(self):
+        if self.dispatcher is None:
+            self.dispatcher = asyncio.create_task(self._dispatch())
+
+    async def close(self):
+        self.ready = False
+        for parent in list(self.parents):
+            if not parent.future.done():
+                parent.future.set_exception(
+                    DecisionError(503, "service stopping", "unavailable")
+                )
+            await self._cleanup(parent)
+        if self.dispatcher:
+            self.dispatcher.cancel()
+            await asyncio.gather(self.dispatcher, return_exceptions=True)
+            self.dispatcher = None
+
+    async def _dispatch(self):
+        while True:
+            await self.wakeup.wait()
+            self.wakeup.clear()
+            while self.inflight < self.limits.children:
+                selected = None
+                for _ in range(len(self.parents)):
+                    parent = self.parents[0]
+                    self.parents.rotate(-1)
+                    if (
+                        not parent.closed
+                        and not parent.future.done()
+                        and parent.next_index < len(parent.prepared.branches)
+                        and len(parent.running) < self.limits.fanout
+                    ):
+                        selected = parent
+                        break
+                if selected is None:
+                    break
+                index = selected.next_index
+                selected.next_index += 1
+                self.inflight += 1
+                if selected.started_at is None:
+                    selected.started_at = time.monotonic()
+                    self.metric(
+                        "queue_seconds", selected.started_at - selected.submitted_at
+                    )
+                child = asyncio.create_task(self._child(selected, index))
+                selected.running[index] = child
+                child.add_done_callback(
+                    lambda task, parent=selected, index=index: self._child_done(
+                        parent, index, task
+                    )
+                )
+                self.metric("inflight_children", 1)
+
+    async def _child(self, parent: Parent, index: int):
+        branch = parent.prepared.branches[index]
+        child_id = f"{parent.request_id}-{index}"
+        completed = False
+        try:
+            p = await self.backend.infer(branch, child_id)
+            completed = True
+            self.metric("completed_input_tokens", len(branch.token_ids))
+            parent.results[index] = answer(branch, p)
+            if (
+                len(parent.results) == len(parent.prepared.branches)
+                and not parent.future.done()
+            ):
+                parent.future.set_result(parent.results)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            if not parent.future.done():
+                parent.future.set_exception(
+                    DecisionError(500, "decision inference failed", "inference_failed")
+                )
+            self.metric("branch_errors")
+            # Keep the original exception available in the server log.
+            asyncio.get_running_loop().call_exception_handler(
+                {"message": "KEV branch failed", "exception": exc}
+            )
+        finally:
+            if not completed:
+                await self.backend.abort(child_id)
+
+    def _child_done(self, parent, index, task):
+        self.inflight -= 1
+        parent.running.pop(index, None)
+        self.metric("inflight_children", -1)
+        self.wakeup.set()
+        if not task.cancelled() and task.exception() is not None:
+            asyncio.get_running_loop().call_exception_handler(
+                {"message": "KEV child cleanup failed", "exception": task.exception()}
+            )
+
+    async def _cleanup(self, parent):
+        parent.closed = True
+        if parent in self.parents:
+            self.parents.remove(parent)
+        children = list(parent.running.values())
+        for child in children:
+            child.cancel()
+        await asyncio.gather(*children, return_exceptions=True)
+        if not parent.future.done():
+            parent.future.cancel()
+        self.wakeup.set()
+
+    async def decide(self, request: SystemOneRequest):
+        received = time.monotonic()
+        if not self.ready or self.backend.errored:
+            self.ready = False
+            raise DecisionError(503, "decision model is not ready", "unavailable")
+        if request.model not in {self.model_id, "kev-latest"}:
+            raise DecisionError(404, "unknown model", "model_not_found")
+        if len(self.parents) >= self.limits.parents:
+            raise DecisionError(429, "parent request capacity reached", "capacity")
+        try:
+            prepared = prepare(request, self.tokenizer, self.limits)
+        except ValueError as exc:
+            raise DecisionError(422, str(exc), "invalid_input") from exc
+        parent = Parent(
+            prepared, asyncio.get_running_loop().create_future(), submitted_at=received
+        )
+        self.parents.append(parent)
+        self.metric("inflight_parents", 1)
+        self.wakeup.set()
+        try:
+            async with asyncio.timeout_at(received + self.limits.timeout):
+                results = await parent.future
+            answers = {
+                branch.question_id: results[i]
+                for i, branch in enumerate(prepared.branches)
+            }
+            self.metric("successful_requests")
+            self.metric("successful_questions", len(answers))
+            self.metric("logical_input_tokens", prepared.logical_tokens)
+            self.metric("successful_actual_input_tokens", prepared.actual_tokens)
+            return {
+                "model": self.model_id,
+                "answers": answers,
+                "usage": {
+                    "input_tokens": prepared.logical_tokens,
+                    "output_tokens": output_tokens(self.tokenizer, answers),
+                },
+                "latency_ms": (time.monotonic() - received) * 1000,
+            }
+        except TimeoutError as exc:
+            self.metric("timeouts")
+            raise DecisionError(504, "decision deadline exceeded", "timeout") from exc
+        except asyncio.CancelledError:
+            self.metric("cancelled_requests")
+            raise
+        except DecisionError:
+            self.metric("failed_requests")
+            raise
+        finally:
+            await self._cleanup(parent)
+            self.metric("inflight_parents", -1)
+            self.metric("end_to_end_seconds", time.monotonic() - received)
