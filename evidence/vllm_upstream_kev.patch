+# SPDX-License-Identifier: Apache-2.0
+import pytest
+from fastapi import FastAPI
+from httpx import ASGITransport, AsyncClient
+from test_service import Backend
+from vllm.entrypoints.pooling.systemone.api_router import router
+from vllm.entrypoints.pooling.systemone.serving import DecisionService
+
+
+@pytest.mark.asyncio
+async def test_http_protocol_and_decision_only_routes(tokenizer):
+    app = FastAPI()
+    service = DecisionService(Backend(), tokenizer, "kev-test")
+    app.state.serving_systemone = service
+    app.state.kev_artifact = {}
+    app.include_router(router)
+    await service.start()
+    try:
+        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
+            assert (await client.get("/v1/systemone/ready")).status_code == 503
+            service.ready = True
+            assert (await client.get("/v1/systemone/ready")).status_code == 200
+            raw = {"state": None, "questions": {"0": {"type": "noul", "instructions": "是吗"}}}
+            response = await client.post("/v1/systemone", json=raw)
+            assert response.status_code == 200 and response.json()["model"] == "kev-test"
+            for extra, status in [({"max_tokens": 1}, 422), ({"model": "missing"}, 404)]:
+                response = await client.post("/v1/systemone", json=raw | extra)
+                assert response.status_code == status
+                assert set(response.json()["error"]) == {"message", "type", "param", "code"}
+            assert (await client.post("/v1/chat/completions", json={})).status_code == 404
+            assert (await client.post("/v1/completions", json={})).status_code == 404
+            service.backend.errored = True
+            assert (await client.get("/v1/systemone/ready")).status_code == 503
+    finally:
+        await service.close()
diff --git a/tests/kev/test_pooler.py b/tests/kev/test_pooler.py
new file mode 100644
index 000000000..94b0e278b
--- /dev/null
+++ b/tests/kev/test_pooler.py
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: Apache-2.0
+import multiprocessing
+
+import msgspec
+import numpy as np
+import pytest
+import torch
+from kev.model import PointerHead
+from vllm.model_executor.layers.pooler.kev import KevPooler
+from vllm.pooling_params import PoolingParams
+from vllm.v1.pool.metadata import PoolingMetadata, PoolingStates
+
+
+def metadata(counts, profile=False):
+    lengths = [count + 3 for count in counts]
+    params = [
+        PoolingParams(
+            task="plugin",
+            extra_kwargs={"version": 1, "option_indices": list(range(1, count + 1)), "decide_index": length - 1},
+        )
+        for count, length in zip(counts, lengths)
+    ]
+    result = PoolingMetadata(
+        torch.tensor(lengths), None, None, params, [PoolingStates() for _ in lengths], is_profile=profile
+    )
+    result.build_pooling_cursor(np.array(lengths), torch.tensor(lengths), torch.device("cpu"))
+    return result
+
+
+@pytest.mark.parametrize("counts", [[1, 2, 8, 255], [255, 8, 1, 2]])
+def test_ragged_pooler_matches_fp32_reference_after_reordering(counts):
+    torch.manual_seed(73)
+    pooler = KevPooler(32, 16, 2.1)
+    reference = PointerHead(32, 16).eval()
+    reference.load_state_dict(pooler.state_dict())
+    reference.temperature = 2.1
+    data = metadata(counts)
+    h = torch.randn(sum(data.prompt_lens.tolist()), 32)
+    actual = pooler(h, data)
+    start = 0
+    for index, (count, length) in enumerate(zip(counts, data.prompt_lens.tolist())):
+        local = h[start : start + length]
+        expected = reference(local[-1], local[1 : count + 1]).softmax(-1)
+        torch.testing.assert_close(actual[index], expected, atol=1e-5, rtol=1e-5)
+        solo = pooler(local, metadata([count]))[0]
+        torch.testing.assert_close(actual[index], solo, atol=1e-5, rtol=1e-5)
+        start += length
+    assert actual[counts.index(1)].tolist() == [1.0]
+
+
+def test_profile_metadata_does_not_relax_normal_validation():
+    pooler = KevPooler(8, 4, 1)
+    data = metadata([1, 2], profile=True)
+    for param in data.pooling_params:
+        param.extra_kwargs = None
+    assert len(pooler(torch.randn(9, 8), data)) == 2
+    data.is_profile = False
+    with pytest.raises(ValueError, match="metadata"):
+        pooler(torch.randn(9, 8), data)
+
+
+@pytest.mark.parametrize("indices,decision", [([100], 3), ([-1], 3), ([1, 1], 3), ([True], 3), ([1], 1)])
+def test_invalid_positions_fail(indices, decision):
+    data = metadata([1])
+    data.pooling_params[0].extra_kwargs.update(option_indices=indices, decide_index=decision)
+    with pytest.raises(ValueError):
+        KevPooler(8, 4, 1)(torch.randn(4, 8), data)
+
+
+def decode_in_process(encoded, queue):
+    params = msgspec.msgpack.decode(encoded, type=PoolingParams)
+    queue.put(params.extra_kwargs)
+
+
+def test_pooling_metadata_survives_serialization_and_process_boundary():
+    params = metadata([8]).pooling_params[0]
+    ctx = multiprocessing.get_context("spawn")
+    queue = ctx.Queue()
+    process = ctx.Process(target=decode_in_process, args=(msgspec.msgpack.encode(params), queue))
+    process.start()
+    try:
+        assert queue.get(timeout=30) == params.extra_kwargs
+        process.join(30)
+        assert process.exitcode == 0
+    finally:
+        if process.is_alive():
+            process.terminate()
+            process.join()
+        queue.close()
diff --git a/tests/kev/test_protocol.py b/tests/kev/test_protocol.py
new file mode 100644
index 000000000..7889472bd
--- /dev/null
+++ b/tests/kev/test_protocol.py
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Input contract: exact KEV rendering and branch boundaries, fail before submission."""
+
+import pytest
+from kev import api as reference
+from kev.model import encode, rows_of
+from pydantic import ValidationError
+from vllm.entrypoints.pooling.systemone.protocol import (
+    Limits,
+    SystemOneRequest,
+    answer,
+    output_tokens,
+    prepare,
+)
+
+
+def mixed_request():
+    return {
+        "state": {"客户": [True, None, {"标记": "<|fim_suffix|>"}]},
+        "questions": {
+            "n": {"type": "noul", "instructions": [False, {"x": 3}], "criteria": {"true": "是"}},
+            "c": {"type": "choice", "instructions": "选", "criteria": {"甲": None, "乙": {"x": [1, 2]}}},
+            "s": {"type": "score", "instructions": None, "criteria": ["低", "中", "高"]},
+        },
+    }
+
+
+def test_input_and_answers_match_pinned_reference(tokenizer):
+    raw = mixed_request()
+    ours = prepare(SystemOneRequest(**raw), tokenizer, Limits())
+    record, meta = reference.to_record(reference.SystemOneRequest(**raw))
+    enc = encode(tokenizer, record, max_state=8192, max_branch=8192, strict=True)
+    state, _, rows = rows_of(enc)
+    for branch, row in zip(ours.branches, rows):
+        assert branch.token_ids == state + row["ids"]
+        assert branch.option_indices == [len(state) + i for i in row["opts"]]
+        assert branch.decide_index == len(state) + row["decide"]
+    probabilities = [[0.05, 0.95], [0.496, 0.504], [0.1, 0.7, 0.2]]
+    answers = {b.question_id: answer(b, p) for b, p in zip(ours.branches, probabilities)}
+    assert answers == reference.to_answers(probabilities, meta)
+    assert answers["c"]["choice"] == "乙"
+    assert ours.logical_tokens == len(enc["ids"])
+    assert ours.actual_tokens == sum(len(b.token_ids) for b in ours.branches)
+    assert output_tokens(tokenizer, answers) == reference.output_tokens(tokenizer, answers)
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {"stream": True},
+        {"max_tokens": 10},
+        {"state": {"x": float("nan")}},
+        {"state": [float("inf")]},
+        {"questions": {}},
+        {"questions": {"q": {"type": "noul", "instructions": "x", "criteria": {"yes": 1}}}},
+        {"questions": {"q": {"type": "score", "instructions": "x", "criteria": [1]}}},
+        {"questions": {"q": {"type": "choice", "instructions": "x", "criteria": {}}}},
+        {"questions": {"q": {"type": "noul", "instructions": "x", "extra": 1}}},
+    ],
+)
+def test_invalid_input_is_rejected(bad):
+    with pytest.raises(ValidationError):
+        SystemOneRequest(**(mixed_request() | bad))
+
+
+def test_isolation_and_question_renaming(tokenizer):
+    raw = mixed_request()
+    original = prepare(SystemOneRequest(**raw), tokenizer, Limits()).branches[1]
+    raw["questions"] = {"renamed": raw["questions"]["c"]}
+    solo = prepare(SystemOneRequest(**raw), tokenizer, Limits()).branches[0]
+    assert original.token_ids == solo.token_ids
+    assert original.metadata() == solo.metadata()
+
+
+@pytest.mark.parametrize(
+    "limits", [Limits(state_tokens=2), Limits(branch_tokens=10), Limits(logical_tokens=10), Limits(questions=1)]
+)
+def test_limits_do_not_truncate(tokenizer, limits):
+    with pytest.raises(ValueError):
+        prepare(SystemOneRequest(**mixed_request()), tokenizer, limits)
+
+
+@pytest.mark.parametrize("count", [1, 2, 8, 255])
+def test_choice_cardinality_and_first_tie(tokenizer, count):
+    request = SystemOneRequest(
+        state="x",
+        questions={"q": {"type": "choice", "instructions": "x", "criteria": {str(i): "" for i in range(count)}}},
+    )
+    branch = prepare(request, tokenizer, Limits()).branches[0]
+    result = answer(branch, [1 / count] * count)
+    assert result["choice"] == "0"
+    assert len(result["probabilities"]) == count
+
+
+def test_probabilities_are_validated_before_rounding(tokenizer):
+    branch = prepare(SystemOneRequest(**mixed_request()), tokenizer, Limits()).branches[0]
+    for bad in ([1.0], [0.8, 0.8], [float("nan"), 0], [-0.1, 1.1]):
+        with pytest.raises(ValueError):
+            answer(branch, bad)
diff --git a/tests/kev/test_service.py b/tests/kev/test_service.py
new file mode 100644
index 000000000..5c5e926e7
