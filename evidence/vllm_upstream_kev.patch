index 000000000..b13ec811f
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/artifact.py
@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Offline verification for fully merged KEV Qwen3 artifacts."""
+
+import hashlib
+import json
+import math
+import re
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+from .protocol import SPECIAL, structural_ids
+
+KEV_REVISION = "90990a5fac2995b9faa3190f7d437e84f2067768"
+MODEL_REVISION = "c4bfa11b0dc07691884f2d97f1c4c4c05c92e416"
+BASE_REVISION = "906bfd4b4dc7f14ee4320094d8b41684abff8539"
+SOURCE_SHA256 = {
+    "head.pt": "dad87f7e60c8b3f1eec8bee83858a5429c6ab06dc96385a935bc88e6b468a45d",
+    "adapter_config.json": (
+        "46d9f1113377e8d0032f0548ae03b270153b2b7ba6dd26b63b244d29487e00e6"
+    ),
+    "adapter_model.safetensors": (
+        "3fa10d8646f567e884ea47841b2f3d5f2d135b81a4447a8ea79a6fc94e9c6ae1"
+    ),
+}
+SHA_PATTERN = re.compile(r"[0-9a-f]{40}")
+HEAD_KEYS = ("q.weight", "q.bias", "k.weight", "k.bias")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def validate_head(head: dict, hidden_size: int, head_dim: int, temperature: float):
+    if not math.isfinite(temperature) or temperature <= 0 or head_dim <= 0:
+        raise ValueError("head temperature and dimension must be positive")
+    if set(head) != set(HEAD_KEYS):
+        raise ValueError("head must contain both query/key weights and biases")
+    for name, tensor in head.items():
+        shape = (head_dim, hidden_size) if name.endswith("weight") else (head_dim,)
+        if tuple(tensor.shape) != shape or tensor.dtype != torch.float32:
+            raise ValueError(f"head shape/dtype mismatch: {name}")
+        if not torch.isfinite(tensor).all():
+            raise ValueError(f"non-finite head parameter: {name}")
+
+
+def validate_artifact(
+    root: str | Path, tokenizer=None, check_tensors: bool = True
+) -> dict:
+    root = Path(root).resolve()
+    manifest = json.loads((root / "kev_manifest.json").read_text())
+    if (
+        manifest["format_version"] != 1
+        or manifest["architecture"] != "KevQwen3ForDecision"
+    ):
+        raise ValueError("unsupported KEV artifact format or architecture")
+    if manifest["option_isolation"] is not False:
+        raise ValueError("option_isolation is unsupported")
+    if (
+        manifest["code_revision"] != KEV_REVISION
+        or manifest["model_revision"] != MODEL_REVISION
+    ):
+        raise ValueError("artifact must pin the approved Qwen3 KEV revisions")
+    if manifest["base_repo"] != "Qwen/Qwen3-4B-Base" or not SHA_PATTERN.fullmatch(
+        manifest["base_revision"]
+    ):
+        raise ValueError("missing immutable Qwen3 base revision")
+    if manifest["head_dtype"] != "float32" or manifest["merge_dtype"] != "float32":
+        raise ValueError("head and merge precision must be float32")
+    if manifest["backbone_dtype"] not in ("float32", "bfloat16", "float16"):
+        raise ValueError("unsupported backbone precision")
+    if manifest["protocol_version"] != 1:
+        raise ValueError("unsupported protocol version")
+    for name in ("adapter_model.safetensors", "head.pt"):
+        if not re.fullmatch(r"[0-9a-f]{64}", manifest["source_sha256"].get(name, "")):
+            raise ValueError(f"missing source checksum: {name}")
+    files = manifest["files"]
+    required = {"config.json", "tokenizer.json", "tokenizer_config.json"}
+    if not required.issubset(files) or not any(
+        n.endswith(".safetensors") for n in files
+    ):
+        raise ValueError("incomplete artifact file inventory")
+    actual = {
+        str(p.relative_to(root))
+        for p in root.rglob("*")
+        if p.is_file() and p.name != "kev_manifest.json"
+    }
+    if actual != set(files):
+        raise ValueError("artifact file inventory mismatch")
+    for name, expected in files.items():
+        path = (root / name).resolve()
+        if (
+            not path.is_relative_to(root)
+            or not path.is_file()
+            or sha256(path) != expected
+        ):
+            raise ValueError(f"artifact checksum/path mismatch: {name}")
+    config = json.loads((root / "config.json").read_text())
+    checks = {
+        "architectures": ["KevQwen3ForDecision"],
+        "model_type": "qwen3",
+        "hidden_size": manifest["hidden_size"],
+        "kev_head_dim": manifest["head_dim"],
+        "kev_temperature": manifest["temperature"],
+        "kev_backbone_dtype": manifest["backbone_dtype"],
+    }
+    for name, expected in checks.items():
+        if config.get(name) != expected:
+            raise ValueError(f"artifact configuration mismatch: {name}")
+    temperature = manifest["temperature"]
+    if not math.isfinite(temperature) or temperature <= 0:
+        raise ValueError("invalid temperature")
+    if tokenizer is not None:
+        expected = dict(zip(SPECIAL, structural_ids(tokenizer)))
+        if manifest["structural_tokens"] != expected:
+            raise ValueError("tokenizer structural IDs mismatch")
+    if check_tensors:
+        head, names = {}, set()
+        for name in sorted(files):
+            if not name.endswith(".safetensors"):
+                continue
+            with safe_open(root / name, framework="pt", device="cpu") as handle:
+                for key in handle.keys():  # noqa: SIM118
+                    if key in names:
+                        raise ValueError(f"duplicate weight: {key}")
+                    names.add(key)
+                    tensor = handle.get_tensor(key)
+                    if not torch.isfinite(tensor).all():
+                        raise ValueError(f"non-finite weight: {key}")
+                    if key.startswith("pooler."):
+                        head[key.removeprefix("pooler.")] = tensor
+                    elif (
+                        not key.startswith("model.")
+                        or str(tensor.dtype).removeprefix("torch.")
+                        != manifest["backbone_dtype"]
+                    ):
+                        raise ValueError(f"unexpected backbone weight/dtype: {key}")
+        if "model.embed_tokens.weight" not in names or "model.norm.weight" not in names:
+            raise ValueError("missing backbone weights")
+        validate_head(head, manifest["hidden_size"], manifest["head_dim"], temperature)
+    return manifest
