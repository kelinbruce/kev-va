new file mode 100644
index 000000000..b7550e364
--- /dev/null
+++ b/tests/kev/test_export.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the real exporter with a tiny trained-shaped Qwen3/LoRA fixture."""
+
+import json
+import sys
+from pathlib import Path
+
+import torch
+from peft import LoraConfig, get_peft_model
+from safetensors.torch import load_file
+from tokenizers import Tokenizer
+from tokenizers.models import WordLevel
+from transformers import PreTrainedTokenizerFast, Qwen3Config, Qwen3Model
+from vllm.entrypoints.pooling.systemone.artifact import BASE_REVISION, sha256, validate_artifact
+from vllm.entrypoints.pooling.systemone.protocol import SPECIAL
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4] / "vllm-upstream/tools/kev"))
+import export as exporter
+
+
+def test_fp32_export_preserves_nonzero_adapter_and_head(tmp_path, monkeypatch):
+    torch.manual_seed(23)
+    base, checkpoint, output = (tmp_path / name for name in ("base", "checkpoint", "output"))
+    base.mkdir()
+    checkpoint.mkdir()
+    config = Qwen3Config(
+        vocab_size=64,
+        hidden_size=32,
+        intermediate_size=64,
+        num_hidden_layers=2,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+        max_position_embeddings=128,
+    )
+    model = Qwen3Model(config).eval()
+    model.save_pretrained(base)
+    vocab = {"[UNK]": 0, **{token: i + 1 for i, token in enumerate(SPECIAL)}}
+    tokenizer = PreTrainedTokenizerFast(
+        tokenizer_object=Tokenizer(WordLevel(vocab, unk_token="[UNK]")),
+        unk_token="[UNK]",
+        additional_special_tokens=list(SPECIAL),
+    )
+    tokenizer.save_pretrained(base)
+    source_lock = {"revision": BASE_REVISION, "files": {p.name: sha256(p) for p in base.iterdir()}}
+    (base / "kev_base_sources.json").write_text(json.dumps(source_lock))
+    adapted = get_peft_model(
+        model,
+        LoraConfig(
+            r=2,
+            lora_alpha=4,
+            task_type="FEATURE_EXTRACTION",
+            target_modules=["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
+        ),
+    )
+    with torch.no_grad():
+        for name, parameter in adapted.named_parameters():
+            if "lora_B" in name:
+                parameter.normal_(std=0.01)
+    adapted.eval().save_pretrained(checkpoint)
+    head = {
+        name: torch.randn(shape)
+        for name, shape in {"q.weight": (8, 32), "q.bias": (8,), "k.weight": (8, 32), "k.bias": (8,)}.items()
+    }
+    torch.save(
+        {"base": "Qwen/Qwen3-4B-Base", "base_revision": BASE_REVISION, "head_dim": 8, "temperature": 2.3, "head": head},
+        checkpoint / "head.pt",
+    )
+    # Replace the approved source digest list with this test's synthetic fixture.
+    monkeypatch.setattr(exporter, "SOURCE_SHA256", {name: sha256(checkpoint / name) for name in exporter.SOURCE_SHA256})
+    inputs = torch.tensor([[1, 9, 2, 10, 3, 11, 4, 5]])
+    with torch.inference_mode():
+        before = adapted(inputs).last_hidden_state
+    exporter.export(checkpoint, base, output, BASE_REVISION, "float32", "tiny-test-only")
+    exported = {}
+    for path in output.glob("*.safetensors"):
+        exported.update(load_file(path))
+    restored = Qwen3Model(config).eval()
+    restored.load_state_dict(
+        {name.removeprefix("model."): value for name, value in exported.items() if name.startswith("model.")},
+        strict=True,
+    )
+    with torch.inference_mode():
+        after = restored(inputs).last_hidden_state
+    torch.testing.assert_close(before, after, atol=1e-5, rtol=1e-5)
+    for name, tensor in head.items():
+        torch.testing.assert_close(exported["pooler." + name], tensor, rtol=0, atol=0)
+    manifest = validate_artifact(output, tokenizer)
+    assert manifest["temperature"] == 2.3
+    assert manifest["validation"]["fp32_merge_parity"] == "not_run"
+    # A dtype cast must affect only the backbone, including on disk.
+    exporter.export(checkpoint, base, tmp_path / "bf16", BASE_REVISION, "bfloat16", "tiny-test-only")
+    for path in (tmp_path / "bf16").glob("*.safetensors"):
+        for name, tensor in load_file(path).items():
+            assert tensor.dtype == (torch.float32 if name.startswith("pooler.") else torch.bfloat16)
