+# SPDX-License-Identifier: Apache-2.0
+"""CPU tests use the actual sibling upstream source and pinned KEV reference."""
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+WORKSPACE = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(WORKSPACE / "vllm-upstream"))
+sys.path.insert(0, str(WORKSPACE / "kev-reference"))
+
+from vllm.entrypoints.pooling.systemone.protocol import SPECIAL  # noqa: E402
+
+
+class CharacterTokenizer:
+    """Deterministic tokenizer for protocol tests; real-tokenizer parity is separate."""
+
+    unk_token_id = None
+
+    def convert_tokens_to_ids(self, text):
+        return SPECIAL.index(text) + 1 if text in SPECIAL else None
+
+    def __call__(self, text, add_special_tokens=False):
+        assert add_special_tokens is False
+        if text in SPECIAL:
+            return SimpleNamespace(input_ids=[self.convert_tokens_to_ids(text)])
+        return SimpleNamespace(input_ids=[ord(c) + 100 for c in text])
+
+
+@pytest.fixture
+def tokenizer():
+    return CharacterTokenizer()
diff --git a/tests/kev/test_artifact.py b/tests/kev/test_artifact.py
