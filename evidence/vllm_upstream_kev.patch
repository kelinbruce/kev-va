+# SPDX-License-Identifier: Apache-2.0
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+from kev.api import SystemOneRequest as ReferenceRequest
+from kev.api import to_record
+from kev.model import encode, rows_of
+from transformers import AutoTokenizer
+from vllm.entrypoints.pooling.systemone.artifact import BASE_REVISION
+from vllm.entrypoints.pooling.systemone.protocol import Limits, SystemOneRequest, prepare
+
+
+def test_real_qwen3_tokenizer_matches_reference_for_frozen_suite():
+    try:
+        tokenizer = AutoTokenizer.from_pretrained("Qwen/Qwen3-4B-Base", revision=BASE_REVISION, local_files_only=True)
+    except OSError:
+        pytest.skip("fixed Qwen3 tokenizer must be downloaded before this parity test")
+    suite = Path(__file__).resolve().parents[2] / "e2e/kev/data/v1"
+    manifest = json.loads((suite / "manifest.json").read_text())
+    data = suite / "parity.jsonl"
+    assert hashlib.sha256(data.read_bytes()).hexdigest() == manifest["sha256"]["parity.jsonl"]
+    questions = 0
+    for line in data.read_text().splitlines():
+        request = json.loads(line)["request"]
+        prepared = prepare(SystemOneRequest(**request), tokenizer, Limits())
+        record, _ = to_record(ReferenceRequest(**request))
+        enc = encode(tokenizer, record, max_state=8192, max_branch=8192, strict=True)
+        state, state_positions, rows = rows_of(enc)
+        for branch, row in zip(prepared.branches, rows):
+            assert branch.token_ids == state + row["ids"]
+            assert list(range(len(branch.token_ids))) == state_positions + row["pos"]
+            assert branch.option_indices == [len(state) + i for i in row["opts"]]
+            assert branch.decide_index == len(state) + row["decide"]
+            questions += 1
+    assert questions == 216
