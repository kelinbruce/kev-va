+# SPDX-License-Identifier: Apache-2.0
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools/kev"))
+from compare import compare
+
+
+def row(name, probabilities, kind="choice"):
+    return {"id": name, "probabilities": probabilities, "type": kind, "keys": list(range(len(probabilities)))}
+
+
+def test_mean_error_is_equal_weight_per_question():
+    reference = [row("a", [0.5, 0.5]), row("b", [0.25] * 4)]
+    candidate = [row("b", [0.255, 0.245, 0.25, 0.25]), row("a", [0.51, 0.49])]
+    result = compare(reference, candidate, require_suite=False)
+    assert result["mean_question_probability_error"] == pytest.approx((0.01 + 0.0025) / 2)
+    assert not result["passed"]
+
+
+def test_protected_business_threshold_flip_fails():
+    reference = [row("a", [0.925, 0.075])]
+    candidate = [row("a", [0.899, 0.101])]
+    result = compare(reference, candidate, require_suite=False)
+    assert not result["passed"]
+    assert result["threshold_flips"][0]["protected"]
+
+
+@pytest.mark.parametrize("candidate", [[row("other", [1])], [row("a", [float("nan")])], [row("a", [0.8])]])
+def test_missing_or_invalid_results_fail(candidate):
+    with pytest.raises(ValueError):
+        compare([row("a", [1])], candidate, require_suite=False)
