index 000000000..4ed1090ac
--- /dev/null
+++ b/tests/kev/test_artifact.py
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: Apache-2.0
+import json
+
+import pytest
+import torch
+from safetensors.torch import save_file
+from vllm.entrypoints.pooling.systemone.artifact import (
+    KEV_REVISION,
+    MODEL_REVISION,
+    sha256,
+    validate_artifact,
+)
+from vllm.entrypoints.pooling.systemone.protocol import SPECIAL, structural_ids
+
+
+def artifact(root, tokenizer):
+    hidden, dim = 8, 4
+    config = {
+        "architectures": ["KevQwen3ForDecision"],
+        "model_type": "qwen3",
+        "hidden_size": hidden,
+        "kev_head_dim": dim,
+        "kev_temperature": 2.1,
+        "kev_backbone_dtype": "float32",
+    }
+    (root / "config.json").write_text(json.dumps(config))
+    for name in ("tokenizer.json", "tokenizer_config.json"):
+        (root / name).write_text("{}")
+    weights = {"model.embed_tokens.weight": torch.randn(100, hidden), "model.norm.weight": torch.ones(hidden)}
+    for prefix in ("q", "k"):
+        weights[f"pooler.{prefix}.weight"] = torch.randn(dim, hidden)
+        weights[f"pooler.{prefix}.bias"] = torch.randn(dim)
+    save_file(weights, root / "model.safetensors")
+    manifest = {
+        "format_version": 1,
+        "protocol_version": 1,
+        "architecture": "KevQwen3ForDecision",
+        "model_revision": MODEL_REVISION,
+        "code_revision": KEV_REVISION,
+        "base_repo": "Qwen/Qwen3-4B-Base",
+        "base_revision": "a" * 40,
+        "head_dim": dim,
+        "hidden_size": hidden,
+        "temperature": 2.1,
+        "option_isolation": False,
+        "backbone_dtype": "float32",
+        "head_dtype": "float32",
+        "merge_dtype": "float32",
+        "source_sha256": {"head.pt": "a" * 64, "adapter_model.safetensors": "b" * 64},
+        "structural_tokens": dict(zip(SPECIAL, structural_ids(tokenizer))),
+        "files": {p.name: sha256(p) for p in root.iterdir()},
+    }
+    (root / "kev_manifest.json").write_text(json.dumps(manifest))
+    return manifest, weights
+
+
+def test_offline_artifact_and_corruption(tmp_path, tokenizer):
+    artifact(tmp_path, tokenizer)
+    assert validate_artifact(tmp_path, tokenizer)["temperature"] == 2.1
+    (tmp_path / "config.json").write_text("{}")
+    with pytest.raises(ValueError, match="checksum"):
+        validate_artifact(tmp_path, tokenizer)
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"temperature": 0},
+        {"option_isolation": True},
+        {"architecture": "Qwen3_5ForConditionalGeneration"},
+        {"base_revision": "main"},
+        {"head_dtype": "bfloat16"},
+    ],
+)
+def test_invalid_manifest_rejected(tmp_path, tokenizer, change):
+    manifest, _ = artifact(tmp_path, tokenizer)
+    (tmp_path / "kev_manifest.json").write_text(json.dumps(manifest | change))
+    with pytest.raises(ValueError):
+        validate_artifact(tmp_path, tokenizer)
+
+
+@pytest.mark.parametrize("damage", ["missing", "shape", "nan", "dtype"])
+def test_invalid_head_rejected_after_valid_checksum(tmp_path, tokenizer, damage):
+    manifest, weights = artifact(tmp_path, tokenizer)
+    if damage == "missing":
+        del weights["pooler.q.bias"]
+    elif damage == "shape":
+        weights["pooler.q.bias"] = torch.zeros(2)
+    elif damage == "nan":
+        weights["pooler.q.bias"][0] = float("nan")
+    else:
+        weights["pooler.q.bias"] = weights["pooler.q.bias"].half()
+    save_file(weights, tmp_path / "model.safetensors")
+    manifest["files"]["model.safetensors"] = sha256(tmp_path / "model.safetensors")
+    (tmp_path / "kev_manifest.json").write_text(json.dumps(manifest))
+    with pytest.raises(ValueError):
+        validate_artifact(tmp_path, tokenizer)
