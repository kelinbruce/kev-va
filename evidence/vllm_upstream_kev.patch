index 000000000..e910c9a80
--- /dev/null
+++ b/tools/kev/export.py
@@ -0,0 +1,219 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Export a pinned Qwen3 KEV checkpoint in an isolated tool environment."""
+
+import argparse
+import importlib.metadata
+import json
+import shutil
+import tempfile
+from pathlib import Path
+
+import torch
+from peft import PeftModel
+from safetensors import safe_open
+from safetensors.torch import load_file, save_file
+from transformers import AutoConfig, AutoModel, AutoTokenizer
+
+from vllm.entrypoints.pooling.systemone.artifact import (
+    BASE_REVISION,
+    KEV_REVISION,
+    MODEL_REVISION,
+    SHA_PATTERN,
+    SOURCE_SHA256,
+    sha256,
+    validate_artifact,
+    validate_head,
+)
+from vllm.entrypoints.pooling.systemone.protocol import SPECIAL, structural_ids
+
+
+def export(
+    checkpoint: Path,
+    base: Path,
+    destination: Path,
+    base_revision: str,
+    dtype: str,
+    model_id: str,
+):
+    if destination.exists():
+        raise ValueError("output directory already exists")
+    if not SHA_PATTERN.fullmatch(base_revision):
+        raise ValueError("base revision must be an immutable 40-character SHA")
+    if base_revision != BASE_REVISION:
+        raise ValueError("base revision does not match the fixed Qwen3 checkpoint")
+    for name, expected in SOURCE_SHA256.items():
+        if sha256(checkpoint / name) != expected:
+            raise ValueError(f"source checkpoint checksum mismatch: {name}")
+    source_lock = json.loads((base / "kev_base_sources.json").read_text())
+    if source_lock["revision"] != base_revision:
+        raise ValueError("base source lock revision mismatch")
+    for name, expected in source_lock["files"].items():
+        path = (base / name).resolve()
+        if not path.is_relative_to(base.resolve()) or sha256(path) != expected:
+            raise ValueError(f"base source checksum mismatch: {name}")
+    metadata = torch.load(checkpoint / "head.pt", map_location="cpu", weights_only=True)
+    if metadata["base"] != "Qwen/Qwen3-4B-Base":
+        raise ValueError("first release only accepts Qwen/Qwen3-4B-Base")
+    if metadata.get("base_revision") not in (None, base_revision):
+        raise ValueError("base revision differs from training metadata")
+    if metadata.get("option_isolation", False) or metadata.get(
+        "special_embeddings", False
+    ):
+        raise ValueError(
+            "option isolation / trained special embeddings are unsupported"
+        )
+    config = AutoConfig.from_pretrained(
+        base, local_files_only=True, trust_remote_code=False
+    )
+    if config.model_type != "qwen3":
+        raise ValueError("only Qwen3 is supported")
+    adapter_config = json.loads((checkpoint / "adapter_config.json").read_text())
+    if (
+        adapter_config.get("trainable_token_indices")
+        or adapter_config.get("modules_to_save")
+        or adapter_config.get("use_dora")
+        or adapter_config.get("peft_type") != "LORA"
+    ):
+        raise ValueError("unsupported adapter structure")
+    head = metadata["head"]
+    # Defaults match the fixed KEV schema only when the checkpoint omits these fields.
+    head_dim = metadata.get("head_dim", 256)
+    temperature = metadata.get("temperature", 1.0)
+    validate_head(head, config.hidden_size, head_dim, temperature)
+    tokenizer = AutoTokenizer.from_pretrained(
+        base, local_files_only=True, trust_remote_code=False
+    )
+    token_ids = structural_ids(tokenizer)
+    backbone = AutoModel.from_pretrained(
+        base,
+        dtype=torch.float32,
+        local_files_only=True,
+        trust_remote_code=False,
+        attn_implementation="eager",
+    )
+    adapted = PeftModel.from_pretrained(
+        backbone, checkpoint, local_files_only=True, is_trainable=False
+    ).eval()
+    merged = adapted.merge_and_unload(safe_merge=True)
+    merged.to(getattr(torch, dtype))
+    merged.config.architectures = ["KevQwen3ForDecision"]
+    merged.config.kev_head_dim = head_dim
+    merged.config.kev_temperature = temperature
+    merged.config.kev_backbone_dtype = dtype
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    staging = Path(tempfile.mkdtemp(prefix=".kev-export-", dir=destination.parent))
+    try:
+        # save_pretrained rewrites architectures to its own class; override afterwards.
+        merged.save_pretrained(staging, safe_serialization=True, max_shard_size="2GB")
+        for weight_path in staging.glob("*.safetensors"):
+            values = load_file(weight_path)
+            save_file(
+                {"model." + k: v for k, v in values.items()},
+                weight_path,
+                metadata={"format": "pt"},
+            )
+        index_path = staging / "model.safetensors.index.json"
+        if index_path.exists():
+            index = json.loads(index_path.read_text())
+            index["weight_map"] = {
+                "model." + k: v for k, v in index["weight_map"].items()
+            }
+        else:
+            with safe_open(staging / "model.safetensors", framework="pt") as handle:
+                index = {
+                    "metadata": {},
+                    "weight_map": {
+                        key: "model.safetensors" for key in list(handle.keys())
+                    },
+                }
+        save_file(
+            {"pooler." + k: v.contiguous() for k, v in head.items()},
+            staging / "kev_head.safetensors",
+            metadata={"format": "pt"},
+        )
+        index["weight_map"].update(
+            {"pooler." + k: "kev_head.safetensors" for k in head}
+        )
+        index_path.write_text(json.dumps(index, indent=2) + "\n")
+        config_data = json.loads((staging / "config.json").read_text())
+        config_data["architectures"] = ["KevQwen3ForDecision"]
+        (staging / "config.json").write_text(json.dumps(config_data, indent=2) + "\n")
+        tokenizer.save_pretrained(staging)
+        manifest = {
+            "format_version": 1,
+            "protocol_version": 1,
+            "model_id": model_id,
+            "architecture": "KevQwen3ForDecision",
+            "model_repo": "jaredpalmer/kev-4b",
+            "model_revision": MODEL_REVISION,
+            "code_revision": KEV_REVISION,
+            "base_repo": metadata["base"],
+            "base_revision": base_revision,
+            "base_source_sha256": source_lock["files"],
+            "base_training_revision": metadata.get("base_revision"),
+            "provenance_gap": metadata.get("base_revision") is None,
+            "hidden_size": config.hidden_size,
+            "head_dim": head_dim,
+            "temperature": temperature,
+            "option_isolation": False,
+            "backbone_dtype": dtype,
+            "head_dtype": "float32",
+            "merge_dtype": "float32",
+            "merge_method": "peft.merge_and_unload(safe_merge=True)",
+            "structural_tokens": dict(zip(SPECIAL, token_ids)),
+            "source_sha256": {
+                name: sha256(checkpoint / name)
+                for name in (
+                    "head.pt",
+                    "adapter_config.json",
+                    "adapter_model.safetensors",
+                )
+            },
+            "versions": {
+                name: importlib.metadata.version(name)
+                for name in ("torch", "peft", "transformers", "safetensors")
+            },
+            "validation": {
+                "fp32_merge_parity": "not_run",
+                "dtype_conversion_error": "not_run",
+                "ascend_real_weights": "not_run",
+            },
+            "files": {
+                str(p.relative_to(staging)): sha256(p)
+                for p in staging.rglob("*")
+                if p.is_file()
+            },
+        }
+        (staging / "kev_manifest.json").write_text(
+            json.dumps(manifest, indent=2) + "\n"
+        )
+        validate_artifact(staging, tokenizer)
+        staging.rename(destination)
+    except BaseException:
+        shutil.rmtree(staging)
+        raise
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--base", type=Path, required=True)
+    parser.add_argument("--base-revision", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument(
+        "--dtype", choices=("float32", "bfloat16", "float16"), required=True
+    )
+    parser.add_argument("--model-id", default="kev-qwen3-4b")
+    args = parser.parse_args()
+    export(
+        args.checkpoint,
+        args.base,
+        args.output,
+        args.base_revision,
+        args.dtype,
+        args.model_id,
+    )
+
+
+if __name__ == "__main__":
+    main()
