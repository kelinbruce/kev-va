+# SPDX-License-Identifier: Apache-2.0
+import asyncio
+
+from prometheus_client import Counter, Gauge, Histogram
+
+from vllm.pooling_params import PoolingParams
+
+from .artifact import validate_artifact
+from .protocol import Limits, SystemOneRequest, answer, prepare
+from .runtime import validate_runtime
+from .serving import DecisionService
+
+
+class EngineBackend:
+    def __init__(self, engine):
+        self.engine = engine
+
+    @property
+    def errored(self):
+        return self.engine.errored
+
+    async def infer(self, branch, request_id):
+        params = PoolingParams(task="plugin", extra_kwargs=branch.metadata())
+        result = None
+        async for output in self.engine.encode(
+            {"prompt_token_ids": branch.token_ids}, params, request_id
+        ):
+            if output.request_id != request_id:
+                raise RuntimeError("KEV engine request ID mismatch")
+            if output.finished:
+                result = output.outputs.data.float().cpu().tolist()
+        if result is None:
+            raise RuntimeError("KEV engine returned no final output")
+        return result
+
+    async def abort(self, request_id):
+        await self.engine.abort(request_id)
+
+
+class Metrics:
+    def __init__(self):
+        self.counters = Counter(
+            "vllm_kev_events", "KEV completed work and lifecycle events", ["event"]
+        )
+        self.gauges = Gauge("vllm_kev_inflight", "KEV in-flight work", ["kind"])
+        self.histograms = Histogram(
+            "vllm_kev_duration_seconds", "KEV queue and end-to-end latency", ["kind"]
+        )
+
+    def __call__(self, name, value):
+        if name.startswith("inflight_"):
+            self.gauges.labels(name).inc(value)
+        elif name.endswith("_seconds"):
+            self.histograms.labels(name).observe(value)
+        else:
+            self.counters.labels(name).inc(value)
+
+
+async def initialize(engine, state):
+    config = engine.model_config.hf_config
+    limits = Limits(**getattr(config, "kev_limits", {}))
+    validate_runtime(engine.vllm_config, limits)
+    tokenizer = engine.renderer.get_tokenizer()
+    manifest = validate_artifact(engine.model_config.model, tokenizer)
+    backend = EngineBackend(engine)
+    service = DecisionService(
+        backend, tokenizer, manifest["model_id"], limits, Metrics()
+    )
+    state.serving_systemone = service
+    state.kev_artifact = {
+        key: manifest[key]
+        for key in (
+            "model_revision",
+            "base_revision",
+            "backbone_dtype",
+            "head_dtype",
+            "temperature",
+        )
+    }
+    probe = SystemOneRequest(
+        state="warmup", questions={"ready": {"type": "noul", "instructions": "ready?"}}
+    )
+    branch = prepare(probe, tokenizer, limits).branches[0]
+    request_id = "kev-initialization-warmup"
+    try:
+        async with asyncio.timeout(limits.timeout):
+            probabilities = await backend.infer(branch, request_id)
+            answer(branch, probabilities)
+    finally:
+        await backend.abort(request_id)
+    await service.start()
+    service.ready = True
diff --git a/vllm/entrypoints/pooling/systemone/protocol.py b/vllm/entrypoints/pooling/systemone/protocol.py
new file mode 100644
index 000000000..e2f7f95ee
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/protocol.py
@@ -0,0 +1,222 @@
+# SPDX-License-Identifier: Apache-2.0
+"""SystemOne protocol, compatible with jaredpalmer/kev@90990a5.
+
+Rendering and answer formulas derive from kev/api.py (Apache-2.0).
+"""
+
+import json
+import math
+import re
+from dataclasses import dataclass
+from typing import Annotated, Any, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, JsonValue, model_validator
+
+MAX_OPTIONS = 255
+SPECIAL = (
+    "<|fim_prefix|>",
+    "<|fim_middle|>",
+    "<|box_start|>",
+    "<|box_end|>",
+    "<|fim_suffix|>",
+)
+SPECIAL_RE = re.compile(r"<\|([A-Za-z0-9_]+)\|>")
+
+
+class StrictModel(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, allow_inf_nan=False)
+
+
+class Noul(StrictModel):
+    type: Literal["noul"]
+    instructions: JsonValue
+    criteria: dict[str, JsonValue] | None = None
+
+    @model_validator(mode="after")
+    def validate_criteria(self):
+        if self.criteria and set(self.criteria) - {"true", "false"}:
+            raise ValueError("noul criteria only accepts true and false")
+        return self
+
+
+class Choice(StrictModel):
+    type: Literal["choice"]
+    instructions: JsonValue
+    criteria: dict[str, JsonValue] = Field(min_length=1, max_length=MAX_OPTIONS)
+
+
+class Score(StrictModel):
+    type: Literal["score"]
+    instructions: JsonValue
+    criteria: list[JsonValue] = Field(min_length=2, max_length=MAX_OPTIONS)
+
+
+Question = Annotated[Noul | Choice | Score, Field(discriminator="type")]
+
+
+class SystemOneRequest(StrictModel):
+    state: JsonValue
+    model: str = "kev-latest"
+    questions: dict[str, Question] = Field(min_length=1)
+
+
+@dataclass(frozen=True)
+class Limits:
+    questions: int = 32
+    state_tokens: int = 8192
+    branch_tokens: int = 8192
+    logical_tokens: int = 32768
+    parents: int = 32
+    children: int = 16
+    fanout: int = 4
+    timeout: float = 30.0
+
+    def __post_init__(self):
+        for name, value in vars(self).items():
+            if isinstance(value, bool) or not math.isfinite(value) or value <= 0:
+                raise ValueError(f"{name} must be positive and finite")
+            if name != "timeout" and not isinstance(value, int):
+                raise ValueError(f"{name} must be an integer")
+        if self.fanout > self.children:
+            raise ValueError("fanout cannot exceed global children")
+
+
+def render(value: JsonValue, indent: int = 0) -> str:
+    pad = "  " * indent
+    if value is None:
+        return ""
+    if isinstance(value, (str, int, float, bool)):
+        return str(value)
+    if isinstance(value, list):
+        return "\n".join(f"{pad}- {render(x, indent + 1).lstrip()}" for x in value)
+    return "\n".join(
+        f"{pad}{key}:\n{render(item, indent + 1)}"
+        if isinstance(item, (dict, list))
+        else f"{pad}{key}: {render(item)}"
+        for key, item in value.items()
+    )
+
+
+def option_text(name: str, desc: JsonValue) -> str:
+    return name if desc is None or desc == "" else f"{name}: {render(desc)}"
+
+
+def user_tokens(tokenizer, text: str) -> list[int]:
+    return tokenizer(
+        SPECIAL_RE.sub(r"<¦\1¦>", text), add_special_tokens=False
+    ).input_ids
+
+
+def structural_ids(tokenizer) -> list[int]:
+    ids = [tokenizer.convert_tokens_to_ids(token) for token in SPECIAL]
+    if len(set(ids)) != len(SPECIAL) or any(
+        not isinstance(i, int) or i < 0 or i == tokenizer.unk_token_id for i in ids
+    ):
+        raise ValueError("invalid KEV structural token IDs")
+    for token, token_id in zip(SPECIAL, ids):
+        if tokenizer(token, add_special_tokens=False).input_ids != [token_id]:
+            raise ValueError(f"structural token is not atomic: {token}")
+    return ids
+
+
+@dataclass(frozen=True)
+class Branch:
+    question_id: str
+    question: Noul | Choice | Score
+    token_ids: list[int]
+    option_indices: list[int]
+    decide_index: int
+    keys: list[str]
+    legend: dict[str, str] | None
+
+    def metadata(self) -> dict:
+        return {
+            "version": 1,
+            "option_indices": self.option_indices,
+            "decide_index": self.decide_index,
+        }
+
+
+@dataclass(frozen=True)
+class PreparedRequest:
+    branches: list[Branch]
+    logical_tokens: int
+    actual_tokens: int
+
+
+def prepare(request: SystemOneRequest, tokenizer, limits: Limits) -> PreparedRequest:
+    if len(request.questions) > limits.questions:
+        raise ValueError("too many questions")
+    state_id, question_id, option_id, close_id, decide_id = structural_ids(tokenizer)
+    state = [state_id] + user_tokens(tokenizer, render(request.state))
+    if len(state) > limits.state_tokens:
+        raise ValueError("state token limit exceeded")
+    branches = []
+    logical = len(state)
+    for qid, question in request.questions.items():
+        legend = None
+        if isinstance(question, Noul):
+            criteria = question.criteria or {}
+            keys = ["false", "true"]
+            options = [
+                option_text("no", criteria.get("false")),
+                option_text("yes", criteria.get("true")),
+            ]
+        elif isinstance(question, Choice):
+            keys = list(question.criteria)
+            options = [option_text(k, v) for k, v in question.criteria.items()]
+        else:
+            keys = [str(i) for i in range(len(question.criteria))]
+            options = [render(v) for v in question.criteria]
+            legend = dict(zip(keys, options))
+        ids = (
+            state
+            + [question_id]
+            + user_tokens(tokenizer, render(question.instructions))
+        )
+        ends = []
+        for option in options:
+            ids += [option_id] + user_tokens(tokenizer, option) + [close_id]
+            ends.append(len(ids) - 1)
+        ids.append(decide_id)
+        if len(ids) > limits.branch_tokens:
+            raise ValueError(f"branch token limit exceeded: {qid}")
+        logical += len(ids) - len(state)
+        if logical > limits.logical_tokens:
+            raise ValueError("logical token limit exceeded")
+        branches.append(Branch(qid, question, ids, ends, len(ids) - 1, keys, legend))
+    return PreparedRequest(branches, logical, sum(len(b.token_ids) for b in branches))
+
+
+def answer(branch: Branch, probabilities: list[float]) -> dict[str, Any]:
+    p = probabilities
+    if len(p) != len(branch.keys) or any(
+        not math.isfinite(x) or not 0 <= x <= 1 for x in p
+    ):
+        raise ValueError("invalid probability vector")
+    if abs(sum(p) - 1) > 1e-6:
+        raise ValueError("probabilities do not sum to one")
+    if isinstance(branch.question, Noul):
+        return {"type": "noul", "noul": round(float(p[1]), 2)}
+    mode = max(range(len(p)), key=p.__getitem__)
+    distribution = {key: round(float(value), 2) for key, value in zip(branch.keys, p)}
+    if isinstance(branch.question, Choice):
+        confidence = 1.0 if len(p) == 1 else (max(p) - 1 / len(p)) / (1 - 1 / len(p))
+        return {
+            "type": "choice",
+            "choice": branch.keys[mode],
+            "confidence": round(float(confidence), 2),
+            "probabilities": distribution,
+        }
+    confidence = 1 - sum(x * abs(i - mode) for i, x in enumerate(p)) / (len(p) - 1)
+    return {
+        "type": "score",
+        "score": round(sum(i * float(x) for i, x in enumerate(p)), 2),
+        "legend": branch.legend,
+        "probabilities": distribution,
+        "confidence": round(float(confidence), 2),
+    }
+
+
+def output_tokens(tokenizer, answers: dict) -> int:
+    return len(tokenizer(json.dumps(answers), add_special_tokens=False).input_ids)
