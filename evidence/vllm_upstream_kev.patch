@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: Apache-2.0
+from collections.abc import Iterable
+
+import torch
+from torch import nn
+
+from vllm import envs
+from vllm.config import VllmConfig
+from vllm.entrypoints.pooling.systemone.artifact import validate_artifact
+from vllm.entrypoints.pooling.systemone.protocol import Limits
+from vllm.entrypoints.pooling.systemone.runtime import validate_runtime
+from vllm.model_executor.layers.pooler.kev import KevPooler
+from vllm.model_executor.models.qwen3 import Qwen3Model
+from vllm.model_executor.models.utils import AutoWeightsLoader, maybe_prefix
+
+
+class KevQwen3ForDecision(nn.Module):
+    is_pooling_model = True
+    attn_type = "decoder"
+    packed_modules_mapping = {
+        "qkv_proj": ["q_proj", "k_proj", "v_proj"],
+        "gate_up_proj": ["gate_proj", "up_proj"],
+    }
+    hf_to_vllm_mapper = Qwen3Model.hf_to_vllm_mapper
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = ""):
+        super().__init__()
+        if envs.VLLM_USE_V2_MODEL_RUNNER:
+            raise ValueError("KEV plugin pooling requires VLLM_USE_V2_MODEL_RUNNER=0")
+        config = vllm_config.model_config.hf_config
+        limits = Limits(**getattr(config, "kev_limits", {}))
+        validate_runtime(vllm_config, limits)
+        validate_artifact(vllm_config.model_config.model)
+        self.model = Qwen3Model(
+            vllm_config=vllm_config, prefix=maybe_prefix(prefix, "model")
+        )
+        self.pooler = KevPooler(
+            config.hidden_size, config.kev_head_dim, config.kev_temperature
+        )
+        self.make_empty_intermediate_tensors = (
+            self.model.make_empty_intermediate_tensors
+        )
+
+    def embed_input_ids(self, input_ids):
+        return self.model.embed_input_ids(input_ids)
+
+    def forward(
+        self, input_ids, positions, intermediate_tensors=None, inputs_embeds=None
+    ):
+        return self.model(input_ids, positions, intermediate_tensors, inputs_embeds)
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        loaded = AutoWeightsLoader(self).load_weights(weights)
+        missing = set(dict(self.named_parameters())) - loaded
+        if missing:
+            raise ValueError(f"missing KEV parameters: {sorted(missing)}")
+        return loaded
