new file mode 100644
index 000000000..143940848
--- /dev/null
+++ b/vllm/model_executor/layers/pooler/kev.py
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Causal KEV pointer readout; only selected positions are projected."""
+
+import math
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.pooler.abstract import Pooler
+from vllm.v1.pool.metadata import PoolingMetadata
+
+MAX_OPTIONS = 255
+
+
+class KevPooler(Pooler):
+    def __init__(self, hidden_size: int, head_dim: int, temperature: float):
+        super().__init__()
+        if head_dim <= 0 or not math.isfinite(temperature) or temperature <= 0:
+            raise ValueError("invalid KEV head dimension or temperature")
+        self.q = nn.Linear(hidden_size, head_dim, dtype=torch.float32)
+        self.k = nn.Linear(hidden_size, head_dim, dtype=torch.float32)
+        self.scale = head_dim**-0.5
+        self.temperature = temperature
+
+    def get_supported_tasks(self):
+        return {"plugin"}
+
+    def forward(self, hidden_states: torch.Tensor, pooling_metadata: PoolingMetadata):
+        cursor = pooling_metadata.get_pooling_cursor()
+        if cursor.is_partial_prefill():
+            raise ValueError(
+                "KEV requires whole sequences: disable APC and chunked prefill"
+            )
+        lengths = cursor.prompt_lens_cpu.tolist()
+        option_positions, decision_positions, counts = [], [], []
+        for length, params in zip(lengths, pooling_metadata.pooling_params):
+            if pooling_metadata.is_profile:
+                indices, decision = [length - 1], length - 1
+            else:
+                data = params.extra_kwargs or {}
+                if (
+                    set(data) != {"version", "option_indices", "decide_index"}
+                    or data["version"] != 1
+                ):
+                    raise ValueError("missing or invalid KEV readout metadata")
+                indices, decision = data["option_indices"], data["decide_index"]
+                if (
+                    not isinstance(indices, list)
+                    or not 1 <= len(indices) <= MAX_OPTIONS
+                    or any(
+                        type(i) is not int or not 0 <= i < length - 1 for i in indices
+                    )
+                    or sorted(set(indices)) != indices
+                    or type(decision) is not int
+                    or decision != length - 1
+                ):
+                    raise ValueError("invalid KEV readout positions")
+            counts.append(len(indices))
+            option_positions.extend(indices)
+            decision_positions.append(decision)
+        device = hidden_states.device
+        count_tensor = torch.tensor(counts, device=device)
+        offsets = cursor.first_token_indices_gpu
+        option_index = torch.tensor(
+            option_positions, device=device
+        ) + torch.repeat_interleave(
+            offsets, count_tensor, output_size=len(option_positions)
+        )
+        decision_index = torch.tensor(decision_positions, device=device) + offsets
+        queries = self.q(hidden_states[decision_index].float())
+        keys = self.k(hidden_states[option_index].float())
+        queries = torch.repeat_interleave(
+            queries, count_tensor, dim=0, output_size=len(option_positions)
+        )
+        logits = (keys * queries).sum(-1) * self.scale / self.temperature
+        return [part.softmax(-1) for part in logits.split(counts)]
