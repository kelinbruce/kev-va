+# SPDX-License-Identifier: Apache-2.0
+import asyncio
+
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse
+from pydantic import ValidationError
+
+from .protocol import SystemOneRequest
+from .serving import DecisionError
+
+router = APIRouter()
+
+
+@router.post("/v1/systemone")
+async def systemone(raw_request: Request):
+    handler = raw_request.app.state.serving_systemone
+    try:
+        request = SystemOneRequest.model_validate(await raw_request.json())
+    except (ValidationError, ValueError) as exc:
+        return JSONResponse(
+            DecisionError(422, str(exc), "invalid_input").response(), status_code=422
+        )
+
+    async def disconnected():
+        while True:
+            message = await raw_request.receive()
+            if message["type"] == "http.disconnect":
+                return
+
+    work = asyncio.create_task(handler.decide(request))
+    disconnect = asyncio.create_task(disconnected())
+    try:
+        done, _ = await asyncio.wait(
+            (work, disconnect), return_when=asyncio.FIRST_COMPLETED
+        )
+        if work in done:
+            return await work
+        return JSONResponse(
+            DecisionError(499, "client disconnected", "cancelled").response(),
+            status_code=499,
+        )
+    except DecisionError as exc:
+        return JSONResponse(exc.response(), status_code=exc.status)
+    finally:
+        work.cancel()
+        disconnect.cancel()
+        await asyncio.gather(work, disconnect, return_exceptions=True)
+
+
+@router.get("/v1/systemone/ready")
+async def ready(request: Request):
+    handler = request.app.state.serving_systemone
+    if handler.backend.errored:
+        handler.ready = False
+    if not handler.ready:
+        return JSONResponse(
+            DecisionError(503, "decision model is not ready", "unavailable").response(),
+            status_code=503,
+        )
+    return {
+        "ready": True,
+        "model": handler.model_id,
+        "artifact": request.app.state.kev_artifact,
+    }
