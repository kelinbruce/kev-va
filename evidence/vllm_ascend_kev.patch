+# SPDX-License-Identifier: Apache-2.0
+"""HTTP benchmark: latency and completed work only, never neural decode tokens/s."""
+
+import argparse
+import asyncio
+import json
+import math
+import time
+from pathlib import Path
+
+import httpx
+from transformers import AutoTokenizer
+
+
+def percentile(values, fraction):
+    values = sorted(values)
+    return values[max(0, math.ceil(len(values) * fraction) - 1)] if values else None
+
+
+async def measure(client, payload, concurrency, samples, actual_tokens, question_count):
+    semaphore = asyncio.Semaphore(concurrency)
+    latencies, errors = [], []
+
+    async def one():
+        async with semaphore:
+            started = time.monotonic()
+            try:
+                response = await client.post("/v1/systemone", json=payload)
+                if response.status_code == 200:
+                    latencies.append(time.monotonic() - started)
+                else:
+                    errors.append(str(response.status_code))
+            except httpx.HTTPError as exc:
+                errors.append(type(exc).__name__)
+
+    started = time.monotonic()
+    await asyncio.gather(*(one() for _ in range(samples)))
+    elapsed = time.monotonic() - started
+    return {
+        "samples": samples,
+        "successful": len(latencies),
+        "errors": errors,
+        "elapsed_seconds": elapsed,
+        "p50_ms": percentile(latencies, 0.5) * 1000 if latencies else None,
+        "p95_ms": percentile(latencies, 0.95) * 1000 if latencies else None,
+        "requests_per_second": len(latencies) / elapsed,
+        "questions_per_second": len(latencies) * question_count / elapsed,
+        "successful_actual_input_tokens_per_second": len(latencies) * actual_tokens / elapsed,
+        "failed_work_tokens": "not_observable_from_HTTP",
+        "peak_npu_memory": "capture_with_npu_smi_in_parallel",
+    }
+
+
+async def run(args):
+    from vllm.entrypoints.pooling.systemone.protocol import Limits, SystemOneRequest, prepare, user_tokens
+
+    tokenizer = AutoTokenizer.from_pretrained(args.model, local_files_only=True)
+    cases = {(length, 1, 2, 1) for length in (128, 1024, 4096)}
+    cases |= {(128, q, 2, 1) for q in (1, 4, 16)}
+    cases |= {(128, 1, k, 1) for k in (2, 8, 32)}
+    cases |= {(128, 1, 2, c) for c in (1, 4, 16)}
+    cases.add((1024, 4, 8, 4))
+    reports = []
+    async with httpx.AsyncClient(base_url=args.url, timeout=60) as client:
+        for length, questions, options, concurrency in sorted(cases):
+            state = "x" + " x" * (length - 2)
+            payload = {
+                "state": state,
+                "questions": {
+                    str(i): {
+                        "type": "choice",
+                        "instructions": "Choose",
+                        "criteria": {str(k): "" for k in range(options)},
+                    }
+                    for i in range(questions)
+                },
+            }
+            prepared = prepare(SystemOneRequest(**payload), tokenizer, Limits())
+            for _ in range(args.warmup):
+                response = await client.post("/v1/systemone", json=payload)
+                response.raise_for_status()
+            report = await measure(client, payload, concurrency, args.samples, prepared.actual_tokens, questions)
+            reports.append(
+                {
+                    "target_state_tokens": length,
+                    "actual_state_tokens": 1 + len(user_tokens(tokenizer, state)),
+                    "questions": questions,
+                    "options": options,
+                    "concurrency": concurrency,
+                    "warmup_requests": args.warmup,
+                    **report,
+                }
+            )
+    args.output.write_text(json.dumps(reports, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8000")
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--samples", type=int, default=50)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--output", type=Path, required=True)
+    asyncio.run(run(parser.parse_args()))
