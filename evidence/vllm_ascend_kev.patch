+# SPDX-License-Identifier: Apache-2.0
+import pytest
+from fastapi import FastAPI
+from httpx import ASGITransport, AsyncClient
+from test_service import Backend
+from vllm.entrypoints.pooling.systemone.api_router import router
+from vllm.entrypoints.pooling.systemone.serving import DecisionService
+
+
+@pytest.mark.asyncio
+async def test_http_protocol_and_decision_only_routes(tokenizer):
+    app = FastAPI()
+    service = DecisionService(Backend(), tokenizer, "kev-test")
+    app.state.serving_systemone = service
+    app.state.kev_artifact = {}
+    app.include_router(router)
+    await service.start()
+    try:
+        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
+            assert (await client.get("/v1/systemone/ready")).status_code == 503
+            service.ready = True
+            assert (await client.get("/v1/systemone/ready")).status_code == 200
+            raw = {"state": None, "questions": {"0": {"type": "noul", "instructions": "是吗"}}}
+            response = await client.post("/v1/systemone", json=raw)
+            assert response.status_code == 200 and response.json()["model"] == "kev-test"
+            for extra, status in [({"max_tokens": 1}, 422), ({"model": "missing"}, 404)]:
+                response = await client.post("/v1/systemone", json=raw | extra)
+                assert response.status_code == status
+                assert set(response.json()["error"]) == {"message", "type", "param", "code"}
+            assert (await client.post("/v1/chat/completions", json={})).status_code == 404
+            assert (await client.post("/v1/completions", json={})).status_code == 404
+            service.backend.errored = True
+            assert (await client.get("/v1/systemone/ready")).status_code == 503
+    finally:
+        await service.close()
