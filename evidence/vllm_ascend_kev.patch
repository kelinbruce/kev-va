+# SPDX-License-Identifier: Apache-2.0
+"""Create deterministic engineering parity inputs (not an accuracy benchmark)."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def freeze(output):
+    if output.exists():
+        raise ValueError("refusing to overwrite a frozen suite")
+    output.mkdir(parents=True)
+    rows = []
+    for index in range(72):
+        state = [
+            f"Case {index}. refund charged twice. 客户要求退款。" * (1 + index % 8),
+            {
+                "case": index,
+                "active": True,
+                "missing": None,
+                "literal": "<|fim_suffix|> <|box_end|>",
+                "nested": [1, {"a": "中文"}],
+            },
+        ]
+        count = (2, 8, 32)[index % 3]
+        rows.append(
+            {
