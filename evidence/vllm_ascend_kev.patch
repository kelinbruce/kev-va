+# SPDX-License-Identifier: Apache-2.0
+"""Collect evidence without changing drivers, dependencies, or the running service."""
+
+import argparse
+import importlib.metadata
+import importlib.util
+import json
+import platform
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+def command(args):
+    try:
+        result = subprocess.run(args, capture_output=True, text=True, timeout=30)
+        return {
+            "command": args,
+            "returncode": result.returncode,
+            "stdout": result.stdout.strip(),
+            "stderr": result.stderr.strip(),
+        }
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return {"command": args, "error": str(exc)}
+
+
+def collect(vllm_root, ascend_root, image_digest=None):
+    packages = {}
+    for name in ("torch", "torch-npu", "transformers", "triton-ascend", "vllm", "vllm-ascend"):
+        try:
+            packages[name] = importlib.metadata.version(name)
+        except importlib.metadata.PackageNotFoundError:
+            packages[name] = None
+    paths = {}
+    for name in ("vllm", "vllm_ascend", "torch", "torch_npu"):
+        spec = importlib.util.find_spec(name)
+        paths[name] = spec.origin if spec else None
+    versions = {}
+    for pattern in (
+        "/usr/local/Ascend/ascend-toolkit/latest/*version*",
+        "/usr/local/Ascend/nnal/atb/latest/*version*",
+        "/usr/local/Ascend/driver/version.info",
+    ):
+        for path in Path("/").glob(pattern.lstrip("/")):
+            if path.is_file():
+                versions[str(path.resolve())] = path.read_text(errors="replace")
+    libraries = []
+    maps = Path("/proc/self/maps")
+    if maps.exists():
+        libraries = sorted(
+            {line.split()[-1] for line in maps.read_text().splitlines() if "Ascend" in line or "libascend" in line}
+        )
+    return {
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        "platform": platform.platform(),
+        "python": platform.python_version(),
+        "packages": packages,
+        "import_paths": paths,
+        "image_digest": image_digest,
+        "version_files": versions,
+        "loaded_ascend_libraries_in_collector": libraries,
+        "npu_smi": command(["npu-smi", "info"]),
+        "vllm_commit": command(["git", "-C", str(vllm_root), "rev-parse", "HEAD"]),
+        "ascend_commit": command(["git", "-C", str(ascend_root), "rev-parse", "HEAD"]),
+        "validation": {
+            "cann_9_0_1_with_vllm_0_26": "pending",
+            "qwen3_real_weights": "not_run",
+            "kev_real_weights": "not_run",
+        },
+        "notes": [
+            "Run inside the actual serving container; directory versions alone do not prove loaded CANN.",
+            "The collector does not load torch-npu or exercise NPU kernels.",
+            "Record firmware, image digest and actual worker library paths separately when unavailable.",
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--vllm-root", type=Path, required=True)
+    parser.add_argument("--ascend-root", type=Path, required=True)
+    parser.add_argument("--image-digest")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(collect(args.vllm_root, args.ascend_root, args.image_digest), ensure_ascii=False, indent=2) + "\n"
+    )
+
+
+if __name__ == "__main__":
+    main()
