+++ b/tests/ut/kev/test_service.py
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+import asyncio
+
+import pytest
+from vllm.entrypoints.pooling.systemone.protocol import Limits, SystemOneRequest
+from vllm.entrypoints.pooling.systemone.serving import DecisionError, DecisionService
+
+
+class Backend:
+    errored = False
+
+    def __init__(self):
+        self.calls = []
+        self.aborted = []
+        self.fail = False
+        self.delay = 0.002
+        self.active = 0
+        self.peak = 0
+
+    async def infer(self, branch, request_id):
+        self.calls.append((branch.question_id, request_id))
+        self.active += 1
+        self.peak = max(self.peak, self.active)
+        try:
+            await asyncio.sleep(self.delay * (1 + int(branch.question_id) % 3))
+            if self.fail:
+                raise RuntimeError("injected failure")
+            return [0.1, 0.9]
+        finally:
+            self.active -= 1
+
+    async def abort(self, request_id):
+        self.aborted.append(request_id)
+
+
+def request(count=6):
+    return SystemOneRequest(state="x", questions={str(i): {"type": "noul", "instructions": "x"} for i in range(count)})
+
+
+@pytest.mark.asyncio
+async def test_mixed_requests_bound_concurrency_and_map_results(tokenizer):
+    backend = Backend()
+    service = DecisionService(backend, tokenizer, "model", Limits(children=3, fanout=2))
+    await service.start()
+    service.ready = True
+    try:
+        responses = await asyncio.gather(*(service.decide(request()) for _ in range(3)))
+        assert backend.peak <= 3
+        assert len({rid for _, rid in backend.calls}) == 18
+        assert all(list(r["answers"]) == list(request().questions) for r in responses)
+        assert all(r["answers"]["0"]["noul"] == 0.9 for r in responses)
+        # The first dispatch round admits one child from each parent.
+        assert len({rid.rsplit("-", 1)[0] for _, rid in backend.calls[:3]}) == 3
+        assert not service.parents and service.inflight == 0
+    finally:
+        await service.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode,status", [("timeout", 504), ("failure", 500), ("cancel", None)])
+async def test_cleanup_and_recovery(tokenizer, mode, status):
+    backend = Backend()
+    service = DecisionService(backend, tokenizer, "model", Limits(children=2, fanout=1, timeout=0.03))
+    await service.start()
+    service.ready = True
+    try:
+        backend.delay = 1 if mode != "failure" else 0.001
+        backend.fail = mode == "failure"
+        work = asyncio.create_task(service.decide(request()))
+        if mode == "cancel":
+            await asyncio.sleep(0.005)
+            work.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await work
+        else:
+            with pytest.raises(DecisionError) as error:
+                await work
+            assert error.value.status == status
+        assert service.inflight == 0 and not service.parents and backend.active == 0
+        assert len(backend.calls) == 1 and backend.aborted
+        backend.fail, backend.delay = False, 0.001
+        assert (await service.decide(request(1)))["answers"]["0"]["noul"] == 0.9
+    finally:
+        await service.close()
+
+
+@pytest.mark.asyncio
+async def test_rejections_submit_no_children(tokenizer):
+    backend = Backend()
+    service = DecisionService(backend, tokenizer, "model", Limits(parents=1, branch_tokens=40))
+    await service.start()
+    try:
+        with pytest.raises(DecisionError) as error:
+            await service.decide(request(1))
+        assert error.value.status == 503
+        service.ready = True
+        bad = request(2)
+        bad.questions["1"].instructions = "x" * 100
+        with pytest.raises(DecisionError) as error:
+            await service.decide(bad)
+        assert error.value.status == 422 and not backend.calls
+        bad = request(1)
+        bad.model = "unknown"
+        with pytest.raises(DecisionError) as error:
+            await service.decide(bad)
+        assert error.value.status == 404 and not backend.calls
+        backend.delay = 0.05
+        first = asyncio.create_task(service.decide(request(1)))
+        await asyncio.sleep(0)
+        with pytest.raises(DecisionError) as error:
+            await service.decide(request(1))
+        assert error.value.status == 429
+        await first
+    finally:
+        await service.close()
