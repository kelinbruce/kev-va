index 000000000..04cd9411e
--- /dev/null
+++ b/tools/kev/compare.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Compare raw probabilities by stable row/question IDs; fail closed on mismatches."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+
+def distribution(row):
+    p = row["probabilities"]
+    if not p or any(not math.isfinite(x) or not 0 <= x <= 1 for x in p) or abs(sum(p) - 1) > 1e-6:
+        raise ValueError(f"invalid probability vector: {row.get('id')}")
+    return p
+
+
+def compare(reference, candidate, mode="migration", require_suite=True):
+    if len({r["id"] for r in reference}) != len(reference) or len({r["id"] for r in candidate}) != len(candidate):
+        raise ValueError("duplicate row IDs")
+    candidate_by_id = {r["id"]: r for r in candidate}
+    if set(candidate_by_id) != {r["id"] for r in reference}:
+        raise ValueError("reference/candidate row ID sets differ")
+    if not reference:
+        raise ValueError("empty comparison")
+    counts = {kind: sum(row["type"] == kind for row in reference) for kind in ("noul", "choice", "score")}
+    if require_suite and (len(reference) < 200 or min(counts.values()) < 30):
+        raise ValueError("suite requires >=200 questions and >=30 of each type")
+    errors, matches, decisive, failures, flips = [], [], [], [], []
+    maximum = 0.0
+    margin_threshold = 0.01 if mode == "batch" else 0.04
+    for row in reference:
+        other = candidate_by_id[row["id"]]
+        if row["type"] != other["type"] or row.get("keys") != other.get("keys"):
+            raise ValueError(f"question type/option order mismatch: {row['id']}")
+        if require_suite:
+            for key in ("data_sha256", "model_revision", "base_revision", "code_revision", "dtype"):
+                if not row.get("provenance", {}).get(key) or row["provenance"][key] != other.get("provenance", {}).get(
+                    key
+                ):
+                    raise ValueError(f"provenance mismatch: {key}")
+            for key in ("token_ids", "positions", "readout"):
+                if row.get(key) is None or row[key] != other.get(key):
+                    raise ValueError(f"input/readout mismatch: {row['id']}: {key}")
+        p, q = distribution(row), distribution(other)
+        if len(p) != len(q):
+            raise ValueError(f"option count mismatch: {row['id']}")
+        differences = [abs(a - b) for a, b in zip(p, q)]
+        error = max(differences)
+        maximum = max(maximum, error)
+        errors.append(sum(differences) / len(p))
+        winner = max(range(len(p)), key=p.__getitem__)
+        match = winner == max(range(len(q)), key=q.__getitem__)
+        matches.append(match)
+        ordered = sorted(p, reverse=True)
+        margin = ordered[0] - ordered[1] if len(p) > 1 else 1.0
+        if margin > margin_threshold:
+            decisive.append(match)
+        threshold_failure = False
+        for threshold in (0.5, 0.8, 0.9):
+            for index, (a, b) in enumerate(zip(p, q)):
+                if (a >= threshold) != (b >= threshold):
+                    protected = abs(a - threshold) > 0.02
+                    threshold_failure |= protected
+                    flips.append({"id": row["id"], "option": index, "threshold": threshold, "protected": protected})
+        limit = {"migration": 0.02, "batch": 0.005, "merge": 1e-4}[mode]
+        if error > limit or (margin > margin_threshold and not match) or (mode == "migration" and threshold_failure):
+            failures.append({"id": row["id"], "max_error": error, "argmax_match": match})
+    mean = sum(errors) / len(errors)
+    agreement = sum(matches) / len(matches)
+    passed = not failures
+    if mode == "migration":
+        passed &= mean <= 0.002 and agreement >= 0.99
+    return {
+        "mode": mode,
+        "questions": len(reference),
+        "type_counts": counts,
+        "mean_question_probability_error": mean,
+        "max_probability_error": maximum,
+        "argmax_agreement": agreement,
+        "decisive_argmax_all_match": all(decisive),
+        "threshold_flips": flips,
+        "failures": failures,
+        "passed": passed,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--mode", choices=("migration", "batch", "merge"), default="migration")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    read = lambda p: [json.loads(line) for line in p.read_text().splitlines() if line]
+    report = compare(read(args.reference), read(args.candidate), args.mode)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    raise SystemExit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
