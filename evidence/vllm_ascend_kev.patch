+# SPDX-License-Identifier: Apache-2.0
+"""Capture unrounded real-weight results for the fixed engineering suite."""
+
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import torch
+
+
+def run(args):
+    from vllm.entrypoints.pooling.systemone.artifact import BASE_REVISION, KEV_REVISION, MODEL_REVISION
+    from vllm.entrypoints.pooling.systemone.protocol import Limits, SystemOneRequest, prepare
+
+    rows = [json.loads(line) for line in args.inputs.read_text().splitlines() if line]
+    provenance = {
+        "data_sha256": hashlib.sha256(args.inputs.read_bytes()).hexdigest(),
+        "model_revision": MODEL_REVISION,
+        "base_revision": BASE_REVISION,
+        "code_revision": KEV_REVISION,
+        "dtype": args.dtype,
+        "mode": args.mode,
+        "merge": args.merge,
+        "device": args.device,
+        "torch": torch.__version__,
+    }
+    if args.mode == "reference":
+        if not args.reference_root:
+            raise ValueError("--reference-root is required")
+        commit = subprocess.check_output(
+            ["git", "-C", str(args.reference_root), "rev-parse", "HEAD"], text=True
+        ).strip()
+        if commit != KEV_REVISION:
+            raise ValueError("KEV reference checkout is not pinned")
+        sys.path.insert(0, str(args.reference_root))
+        from kev.api import SystemOneRequest as ReferenceRequest
+        from kev.api import to_record
+        from kev.checkpoint import Checkpoint, LoadOptions
+        from kev.model import encode
+
+        checkpoint = Checkpoint(str(args.model))
+        tokenizer, model = checkpoint.load(
+            args.device, LoadOptions(dtype=getattr(torch, args.dtype), merge=args.merge, attn="eager")
+        )
+    else:
+        from transformers import AutoTokenizer
+        from vllm import LLM, PoolingParams
+        from vllm.entrypoints.pooling.systemone.artifact import validate_artifact
+
+        tokenizer = AutoTokenizer.from_pretrained(args.model, local_files_only=True)
+        validate_artifact(args.model, tokenizer)
+        model = LLM(
+            model=str(args.model),
+            runner="pooling",
+            dtype=args.dtype,
+            enforce_eager=True,
+            enable_prefix_caching=False,
+            enable_chunked_prefill=False,
+            tensor_parallel_size=1,
+            max_model_len=8192,
+            max_num_seqs=16,
+            max_num_batched_tokens=8192,
+            trust_remote_code=False,
+        )
+    with args.output.open("x", encoding="utf-8") as output:
+        for row in rows:
+            prepared = prepare(SystemOneRequest(**row["request"]), tokenizer, Limits())
+            if args.mode == "reference":
+                record, _ = to_record(ReferenceRequest(**row["request"]))
+                encoding = encode(tokenizer, record, max_state=8192, max_branch=8192, strict=True)
+                with torch.inference_mode():
+                    logits = model(encoding)
+                probabilities = [z.softmax(-1).cpu().tolist() for z in logits]
+                logits = [z.cpu().tolist() for z in logits]
+            else:
+                result = model.encode(
+                    [{"prompt_token_ids": b.token_ids} for b in prepared.branches],
+                    pooling_params=[PoolingParams(task="plugin", extra_kwargs=b.metadata()) for b in prepared.branches],
+                    use_tqdm=False,
+                )
+                probabilities = [r.outputs.data.float().cpu().tolist() for r in result]
+                logits = [None] * len(result)
+            for branch, probability, logit in zip(prepared.branches, probabilities, logits):
+                evidence = {
+                    "id": row["id"] + "/" + branch.question_id,
+                    "type": branch.question.type,
+                    "keys": branch.keys,
+                    "probabilities": probability,
+                    "logits": logit,
+                    "token_ids": branch.token_ids,
+                    "positions": list(range(len(branch.token_ids))),
+                    "readout": branch.metadata(),
+                    "provenance": provenance,
+                }
+                output.write(json.dumps(evidence, ensure_ascii=False) + "\n")
+            output.flush()
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mode", choices=("reference", "engine"), required=True)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--inputs", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--reference-root", type=Path)
+    parser.add_argument("--device", default="cpu")
+    parser.add_argument("--dtype", choices=("float32", "float16", "bfloat16"), required=True)
+    parser.add_argument("--merge", action="store_true")
+    run(parser.parse_args())
