index 000000000..2ff9c2805
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/metrics.py
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from prometheus_client import Counter, Gauge, Histogram
+from typing_extensions import Protocol
+
+_input_tokens = Counter(
+    "vllm:systemone_input_tokens_total",
+    "SystemOne input tokens by logical or actual accounting.",
+    labelnames=("model", "kind"),
+)
+_success = Counter(
+    "vllm:systemone_success_total",
+    "Successful SystemOne requests or questions.",
+    labelnames=("model", "kind"),
+)
+_errors = Counter(
+    "vllm:systemone_errors_total",
+    "SystemOne errors by stable API code.",
+    labelnames=("model", "code"),
+)
+_in_flight = Gauge(
+    "vllm:systemone_in_flight",
+    "SystemOne requests or inference branches currently in flight.",
+    labelnames=("model", "kind"),
+    multiprocess_mode="livesum",
+)
+_queue_duration = Histogram(
+    "vllm:systemone_queue_duration_seconds",
+    "Time a SystemOne inference branch waits for a worker.",
+    labelnames=("model",),
+)
+_request_duration = Histogram(
+    "vllm:systemone_request_duration_seconds",
+    "End-to-end SystemOne request duration.",
+    labelnames=("model",),
+)
+
+
+class DecisionMetrics(Protocol):
+    def request_started(self) -> None: ...
+
+    def request_finished(self, duration_seconds: float) -> None: ...
+
+    def branch_started(self, queue_seconds: float) -> None: ...
+
+    def branch_finished(self) -> None: ...
+
+    def request_succeeded(
+        self, logical_tokens: int, actual_tokens: int, questions: int
+    ) -> None: ...
+
+    def request_failed(self, code: str) -> None: ...
+
+
+class SystemOneMetrics:
+    def __init__(self, model_id: str) -> None:
+        self.model_id = model_id
+
+    def request_started(self) -> None:
+        _in_flight.labels(self.model_id, "request").inc()
+
+    def request_finished(self, duration_seconds: float) -> None:
+        _in_flight.labels(self.model_id, "request").dec()
+        _request_duration.labels(self.model_id).observe(duration_seconds)
+
+    def branch_started(self, queue_seconds: float) -> None:
+        _queue_duration.labels(self.model_id).observe(queue_seconds)
+        _in_flight.labels(self.model_id, "branch").inc()
+
+    def branch_finished(self) -> None:
+        _in_flight.labels(self.model_id, "branch").dec()
+
+    def request_succeeded(
+        self, logical_tokens: int, actual_tokens: int, questions: int
+    ) -> None:
+        _input_tokens.labels(self.model_id, "logical").inc(logical_tokens)
+        _input_tokens.labels(self.model_id, "actual").inc(actual_tokens)
+        _success.labels(self.model_id, "request").inc()
+        _success.labels(self.model_id, "question").inc(questions)
+
+    def request_failed(self, code: str) -> None:
+        _errors.labels(self.model_id, code).inc()
+
+
+__all__ = ["DecisionMetrics", "SystemOneMetrics"]
diff --git a/vllm/entrypoints/pooling/systemone/protocol.py b/vllm/entrypoints/pooling/systemone/protocol.py
new file mode 100644
index 000000000..6a3a67aa7
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/protocol.py
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import math
+from typing import Annotated, Any, Literal, TypeAlias
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator
+
+JSONContent: TypeAlias = str | dict[str, Any] | list[Any] | int | float | bool | None
+MAX_OPTIONS = 255
+
+
+def _validate_json_content(value: Any, path: str = "value") -> Any:
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"{path} must contain only finite numbers")
+        return value
+    if isinstance(value, list):
+        for index, item in enumerate(value):
+            _validate_json_content(item, f"{path}[{index}]")
+        return value
+    if isinstance(value, dict):
+        for key, item in value.items():
+            if not isinstance(key, str):
+                raise ValueError(f"{path} object keys must be strings")
+            _validate_json_content(item, f"{path}.{key}")
+        return value
+    raise ValueError(f"{path} must be JSON-compatible")
+
+
+class SystemOneModel(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+
+
+class QuestionBase(SystemOneModel):
+    instructions: JSONContent
+
+    @field_validator("instructions", mode="before")
+    @classmethod
+    def validate_instructions(cls, value: Any) -> Any:
+        return _validate_json_content(value, "instructions")
+
+
+class NoulQuestion(QuestionBase):
+    type: Literal["noul"]
+    criteria: dict[str, JSONContent] | None = None
+
+    @field_validator("criteria", mode="before")
+    @classmethod
+    def validate_criteria(cls, value: Any) -> Any:
+        if value is None:
+            return None
+        _validate_json_content(value, "criteria")
+        unknown = set(value) - {"false", "true"}
+        if unknown:
+            raise ValueError("noul criteria may contain only false and true")
+        return value
+
+
+class ChoiceQuestion(QuestionBase):
+    type: Literal["choice"]
+    criteria: dict[str, JSONContent] = Field(min_length=1, max_length=MAX_OPTIONS)
+
+    @field_validator("criteria", mode="before")
+    @classmethod
+    def validate_criteria(cls, value: Any) -> Any:
+        return _validate_json_content(value, "criteria")
+
+
+class ScoreQuestion(QuestionBase):
+    type: Literal["score"]
+    criteria: list[JSONContent] = Field(min_length=2, max_length=MAX_OPTIONS)
+
+    @field_validator("criteria", mode="before")
+    @classmethod
+    def validate_criteria(cls, value: Any) -> Any:
+        return _validate_json_content(value, "criteria")
+
+
+Question = Annotated[
+    NoulQuestion | ChoiceQuestion | ScoreQuestion,
+    Field(discriminator="type"),
+]
+
+
+class SystemOneRequest(SystemOneModel):
+    state: JSONContent
+    model: str = "kev-latest"
+    questions: dict[str, Question] = Field(min_length=1)
+
+    @field_validator("state", mode="before")
+    @classmethod
+    def validate_state(cls, value: Any) -> Any:
+        return _validate_json_content(value, "state")
+
+    @model_validator(mode="after")
+    def validate_names(self) -> "SystemOneRequest":
+        if not self.model:
+            raise ValueError("model must not be empty")
+        if any(not question_id for question_id in self.questions):
+            raise ValueError("question IDs must not be empty")
+        return self
