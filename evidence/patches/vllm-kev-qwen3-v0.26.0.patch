@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import json
+import math
+from collections.abc import Sequence
+from typing import Any
+
+from .renderer import PreparedQuestion
+
+PROBABILITY_SUM_TOLERANCE = 1e-6
+
+
+def _validate_probabilities(
+    prepared: PreparedQuestion, probabilities: Sequence[float]
+) -> list[float]:
+    values = [float(value) for value in probabilities]
+    if len(values) != len(prepared.keys):
+        raise ValueError("probability count does not match the question options")
+    if any(not math.isfinite(value) or not 0 <= value <= 1 for value in values):
+        raise ValueError("probabilities must be finite values in [0, 1]")
+    if abs(sum(values) - 1) > PROBABILITY_SUM_TOLERANCE:
+        raise ValueError("probabilities must sum to one")
+    return values
+
+
+def _choice_confidence(probabilities: list[float]) -> float:
+    option_count = len(probabilities)
+    if option_count == 1:
+        return 1.0
+    chance = 1 / option_count
+    return (max(probabilities) - chance) / (1 - chance)
+
+
+def _score_confidence(probabilities: list[float]) -> float:
+    mode = max(range(len(probabilities)), key=probabilities.__getitem__)
+    distance = sum(
+        probability * abs(index - mode)
+        for index, probability in enumerate(probabilities)
+    )
+    return 1 - distance / (len(probabilities) - 1)
+
+
+def _round(value: float) -> float:
+    return round(float(value), 2)
+
+
+def answer_from_probabilities(
+    prepared: PreparedQuestion,
+    probabilities: Sequence[float],
+) -> dict[str, Any]:
+    raw = _validate_probabilities(prepared, probabilities)
+    if prepared.question_type == "noul":
+        return {"type": "noul", "noul": _round(raw[1])}
+    if prepared.question_type == "choice":
+        winner = max(range(len(raw)), key=raw.__getitem__)
+        return {
+            "type": "choice",
+            "choice": prepared.keys[winner],
+            "confidence": _round(_choice_confidence(raw)),
+            "probabilities": {
+                key: _round(value) for key, value in zip(prepared.keys, raw)
+            },
+        }
+    if prepared.question_type == "score":
+        if prepared.legend is None:
+            raise ValueError("score question is missing its legend")
+        score = sum(index * probability for index, probability in enumerate(raw))
+        return {
+            "type": "score",
+            "score": _round(score),
+            "legend": prepared.legend,
+            "probabilities": {
+                key: _round(value) for key, value in zip(prepared.keys, raw)
+            },
+            "confidence": _round(_score_confidence(raw)),
+        }
+    raise ValueError(f"unsupported question type: {prepared.question_type}")
+
+
+def answers_from_probabilities(
+    prepared: Sequence[PreparedQuestion],
+    probabilities: Sequence[Sequence[float]],
+) -> dict[str, dict[str, Any]]:
+    if len(prepared) != len(probabilities):
+        raise ValueError("probability result count does not match the questions")
+    return {
+        question.question_id: answer_from_probabilities(question, values)
+        for question, values in zip(prepared, probabilities)
+    }
+
+
+def serialized_output_tokens(tokenizer: Any, answers: dict[str, Any]) -> int:
+    """Count tokens in the exact JSON representation returned by KEV."""
+    serialized = json.dumps(answers)
+    return len(tokenizer(serialized, add_special_tokens=False).input_ids)
+
+
+__all__ = [
+    "answer_from_probabilities",
+    "answers_from_probabilities",
+    "serialized_output_tokens",
+]
diff --git a/vllm/entrypoints/pooling/systemone/serving.py b/vllm/entrypoints/pooling/systemone/serving.py
new file mode 100644
index 000000000..68be0aeca
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/serving.py
@@ -0,0 +1,394 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import asyncio
+import time
+import uuid
+from collections import deque
+from collections.abc import Sequence
+from contextlib import suppress
+from dataclasses import dataclass
+from typing import Any, Protocol
+
+from .metrics import DecisionMetrics, SystemOneMetrics
+from .protocol import SystemOneRequest
+from .renderer import (
+    DEFAULT_LIMITS,
+    Limits,
+    PreparedQuestion,
+    Tokenizer,
+    prepare_request,
+)
+from .responses import answers_from_probabilities, serialized_output_tokens
+
+
+class DecisionBackend(Protocol):
+    async def infer(
+        self, request_id: str, question: PreparedQuestion
+    ) -> Sequence[float]: ...
+
+    async def abort(self, request_ids: Sequence[str]) -> None: ...
+
+
+class SystemOneError(Exception):
+    def __init__(self, message: str, error_type: str, code: str, status: int):
+        super().__init__(message)
+        self.message = message
+        self.error_type = error_type
+        self.code = code
+        self.status = status
+
+    def as_dict(self) -> dict:
+        return {
+            "error": {
+                "message": self.message,
+                "type": self.error_type,
+                "code": self.code,
+                "param": None,
+            }
+        }
+
+
+@dataclass(frozen=True)
+class ServiceResult:
+    model: str
+    answers: dict
+    input_tokens: int
+    actual_input_tokens: int
+    output_tokens: int
+    latency_ms: float
+
+
+@dataclass
+class _Job:
+    parent_id: str
+    request_id: str
+    question: PreparedQuestion
+    future: asyncio.Future
+    enqueued_at: float
+
+
+class _FairScheduler:
+    def __init__(
+        self,
+        backend: DecisionBackend,
+        global_limit: int,
+        per_parent_limit: int,
+        metrics: DecisionMetrics,
+    ) -> None:
+        self.backend = backend
+        self.global_limit = global_limit
+        self.per_parent_limit = per_parent_limit
+        self.metrics = metrics
+        self._condition = asyncio.Condition()
+        self._queues: dict[str, deque[_Job]] = {}
+        self._order: deque[str] = deque()
+        self._active: dict[str, int] = {}
+        self._workers: list[asyncio.Task] = []
+        self._closed = False
+
+    async def submit(
+        self,
+        parent_id: str,
+        questions: Sequence[PreparedQuestion],
+    ) -> tuple[list[str], list[asyncio.Future]]:
+        self._ensure_workers()
+        loop = asyncio.get_running_loop()
+        jobs = [
+            _Job(
+                parent_id=parent_id,
+                request_id=f"{parent_id}/{index}",
+                question=question,
+                future=loop.create_future(),
+                enqueued_at=time.monotonic(),
+            )
+            for index, question in enumerate(questions)
+        ]
+        async with self._condition:
+            self._queues[parent_id] = deque(jobs)
+            self._active[parent_id] = 0
+            self._order.append(parent_id)
+            self._condition.notify_all()
+        return [job.request_id for job in jobs], [job.future for job in jobs]
+
+    def _ensure_workers(self) -> None:
+        if not self._workers:
+            self._workers = [
+                asyncio.create_task(self._worker()) for _ in range(self.global_limit)
+            ]
+
+    async def cancel_parent(self, parent_id: str) -> None:
+        async with self._condition:
+            queued = self._queues.pop(parent_id, deque())
+            self._remove_from_order(parent_id)
+            for job in queued:
+                if not job.future.done():
+                    job.future.cancel()
+            self._condition.notify_all()
+
+    async def finish_parent(self, parent_id: str) -> None:
+        async with self._condition:
+            while self._active.get(parent_id, 0):
+                await self._condition.wait()
+            self._queues.pop(parent_id, None)
+            self._active.pop(parent_id, None)
+            self._remove_from_order(parent_id)
+
+    async def _next_job(self) -> _Job | None:
+        async with self._condition:
+            while True:
+                if self._closed:
+                    return None
+                for _ in range(len(self._order)):
+                    parent_id = self._order[0]
+                    self._order.rotate(-1)
+                    queue = self._queues[parent_id]
+                    if self._active[parent_id] >= self.per_parent_limit:
+                        continue
+                    job = queue.popleft()
+                    self._active[parent_id] += 1
+                    if not queue:
+                        self._remove_from_order(parent_id)
+                    return job
+                await self._condition.wait()
+
+    async def _worker(self) -> None:
+        while (job := await self._next_job()) is not None:
+            self.metrics.branch_started(time.monotonic() - job.enqueued_at)
+            try:
+                result = await self.backend.infer(job.request_id, job.question)
+                if not job.future.done():
+                    job.future.set_result(result)
+            except BaseException as exc:
+                if not job.future.done():
+                    job.future.set_exception(exc)
+            finally:
+                self.metrics.branch_finished()
+                async with self._condition:
+                    self._active[job.parent_id] -= 1
+                    if (
+                        self._queues.get(job.parent_id)
+                        and job.parent_id not in self._order
+                    ):
+                        self._order.append(job.parent_id)
+                    self._condition.notify_all()
+
+    def _remove_from_order(self, parent_id: str) -> None:
+        with suppress(ValueError):
+            self._order.remove(parent_id)
+
+    async def close(self) -> None:
+        async with self._condition:
+            self._closed = True
+            self._condition.notify_all()
+        await asyncio.gather(*self._workers, return_exceptions=True)
+
+
+class SystemOneService:
+    def __init__(
+        self,
+        backend: DecisionBackend,
+        tokenizer: Tokenizer,
+        model_id: str,
+        *,
+        aliases: Sequence[str] = ("kev-latest",),
+        limits: Limits = DEFAULT_LIMITS,
+        max_parents: int = 32,
+        global_children: int = 16,
+        per_parent_children: int = 4,
+        deadline_seconds: float = 30.0,
+        metrics: DecisionMetrics | None = None,
+    ) -> None:
+        if not model_id:
+            raise ValueError("model_id must not be empty")
+        if not 0 < per_parent_children <= global_children:
+            raise ValueError("per-parent children must not exceed global children")
+        if max_parents <= 0 or deadline_seconds <= 0:
+            raise ValueError("capacity and deadline must be positive")
+        self.backend = backend
+        self.tokenizer = tokenizer
+        self.model_id = model_id
+        self.aliases = frozenset(aliases)
+        self.limits = limits
+        self.max_parents = max_parents
+        self.deadline_seconds = deadline_seconds
+        self.metrics = metrics or SystemOneMetrics(model_id)
+        self.ready = False
+        self.readiness_error: str | None = "not_initialized"
+        self.artifact_manifest: dict[str, Any] | None = None
+        self._parents = 0
+        self._parents_lock = asyncio.Lock()
+        self._scheduler = _FairScheduler(
+            backend, global_children, per_parent_children, self.metrics
+        )
+
+    def set_ready(self, ready: bool, error: str | None = None) -> None:
+        self.ready = ready
+        self.readiness_error = None if ready else error
+
+    def set_artifact_manifest(self, manifest: dict[str, Any]) -> None:
+        self.artifact_manifest = manifest
+
+    def record_error(self, code: str) -> None:
+        self.metrics.request_failed(code)
+
+    async def warmup(self) -> None:
+        """Run one valid decision through the loaded model before readiness."""
+        request = SystemOneRequest.model_validate(
+            {
+                "model": self.model_id,
+                "state": None,
+                "questions": {
+                    "warmup": {
+                        "type": "noul",
+                        "instructions": "warm up",
+                    }
+                },
+            }
+        )
+        prepared = prepare_request(request, self.tokenizer, self.limits).questions[0]
+        request_id = f"systemone-warmup-{uuid.uuid4().hex}/0"
+        self.set_ready(False, "warmup_in_progress")
+        try:
+            probabilities = await self.backend.infer(request_id, prepared)
+            answers_from_probabilities((prepared,), (probabilities,))
+        except BaseException as exc:
+            self.set_ready(False, type(exc).__name__)
+            await self.backend.abort((request_id,))
+            raise
+        self.set_ready(True)
+
+    async def decide(
+        self,
+        request: SystemOneRequest,
+        disconnect_event: asyncio.Event | None = None,
+    ) -> ServiceResult:
+        started = time.monotonic()
+        self.metrics.request_started()
+        try:
+            result = await self._decide(request, disconnect_event, started)
+        except SystemOneError as exc:
+            self.metrics.request_failed(exc.code)
+            raise
+        except asyncio.CancelledError:
+            self.metrics.request_failed("request_cancelled")
+            raise
+        else:
+            self.metrics.request_succeeded(
+                result.input_tokens,
+                result.actual_input_tokens,
+                len(result.answers),
+            )
+            return result
+        finally:
+            self.metrics.request_finished(time.monotonic() - started)
+
+    async def _decide(
+        self,
+        request: SystemOneRequest,
+        disconnect_event: asyncio.Event | None,
+        started: float,
+    ) -> ServiceResult:
+        if request.model != self.model_id and request.model not in self.aliases:
+            raise SystemOneError(
+                "unknown model", "not_found_error", "model_not_found", 404
+            )
+        if not self.ready:
+            raise SystemOneError(
+                "model is not ready", "service_unavailable", "model_not_ready", 503
+            )
+        try:
+            prepared = prepare_request(request, self.tokenizer, self.limits)
+        except ValueError as exc:
+            raise SystemOneError(
+                str(exc), "invalid_request_error", "invalid_request", 422
+            ) from exc
+        await self._admit_parent()
+        parent_id = f"systemone-{uuid.uuid4().hex}"
+        request_ids: list[str] = []
+        succeeded = False
+        try:
+            request_ids, futures = await self._scheduler.submit(
+                parent_id, prepared.questions
+            )
+            probabilities = await self._wait_for_results(futures, disconnect_event)
+            answers = answers_from_probabilities(prepared.questions, probabilities)
+            succeeded = True
+            return ServiceResult(
+                model=self.model_id,
+                answers=answers,
+                input_tokens=prepared.logical_input_tokens,
+                actual_input_tokens=prepared.actual_input_tokens,
+                output_tokens=serialized_output_tokens(self.tokenizer, answers),
+                latency_ms=(time.monotonic() - started) * 1000,
+            )
+        except TimeoutError as exc:
+            raise SystemOneError(
+                "request deadline exceeded", "timeout_error", "deadline_exceeded", 504
+            ) from exc
+        except asyncio.CancelledError:
+            raise
+        except SystemOneError:
+            raise
+        except Exception as exc:
+            raise SystemOneError(
+                "decision inference failed",
+                "server_error",
+                "inference_failed",
+                500,
+            ) from exc
+        finally:
+            if not succeeded:
+                await self._scheduler.cancel_parent(parent_id)
+                if request_ids:
+                    await self.backend.abort(request_ids)
+            await self._scheduler.finish_parent(parent_id)
+            await self._release_parent()
+
+    async def _wait_for_results(
+        self,
+        futures: Sequence[asyncio.Future],
+        disconnect_event: asyncio.Event | None,
+    ) -> list[Sequence[float]]:
+        async with asyncio.timeout(self.deadline_seconds):
+            results = asyncio.gather(*futures)
+            if disconnect_event is None:
+                return await results
+            disconnected = asyncio.create_task(disconnect_event.wait())
+            done, _ = await asyncio.wait(
+                (results, disconnected), return_when=asyncio.FIRST_COMPLETED
+            )
+            if disconnected in done and disconnect_event.is_set():
+                results.cancel()
+                with suppress(asyncio.CancelledError):
+                    await results
+                raise SystemOneError(
+                    "client disconnected",
+                    "cancelled_error",
+                    "client_disconnected",
+                    499,
+                )
+            disconnected.cancel()
+            with suppress(asyncio.CancelledError):
+                await disconnected
+            return await results
+
+    async def _admit_parent(self) -> None:
+        async with self._parents_lock:
+            if self._parents >= self.max_parents:
+                raise SystemOneError(
+                    "request capacity reached",
+                    "rate_limit_error",
+                    "too_many_requests",
+                    429,
+                )
+            self._parents += 1
+
+    async def _release_parent(self) -> None:
+        async with self._parents_lock:
+            self._parents -= 1
+
+    async def close(self) -> None:
+        await self._scheduler.close()
+
+
+__all__ = ["DecisionBackend", "ServiceResult", "SystemOneError", "SystemOneService"]
