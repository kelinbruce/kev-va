diff --git a/vllm/entrypoints/pooling/systemone/api_router.py b/vllm/entrypoints/pooling/systemone/api_router.py
new file mode 100644
index 000000000..6c262b053
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/api_router.py
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import asyncio
+from contextlib import suppress
+from typing import Any
+
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse
+from pydantic import ValidationError
+
+from .protocol import SystemOneRequest
+from .serving import SystemOneError, SystemOneService
+
+router = APIRouter()
+
+
+def _validation_error(exc: Exception) -> JSONResponse:
+    error = SystemOneError(str(exc), "invalid_request_error", "invalid_request", 422)
+    return JSONResponse(content=error.as_dict(), status_code=error.status)
+
+
+async def _watch_disconnect(request: Request, event: asyncio.Event) -> None:
+    while not event.is_set():
+        if await request.is_disconnected():
+            event.set()
+            return
+        await asyncio.sleep(0.01)
+
+
+@router.post("/v1/systemone")
+async def create_systemone(raw_request: Request) -> JSONResponse:
+    handler: SystemOneService | None = getattr(
+        raw_request.app.state, "serving_systemone", None
+    )
+    if handler is None:
+        error = SystemOneError(
+            "the model does not support SystemOne",
+            "not_found_error",
+            "unsupported_endpoint",
+            404,
+        )
+        return JSONResponse(content=error.as_dict(), status_code=error.status)
+    try:
+        payload: Any = await raw_request.json()
+        request = SystemOneRequest.model_validate(payload)
+    except (ValueError, TypeError, ValidationError) as exc:
+        handler.record_error("invalid_request")
+        return _validation_error(exc)
+
+    disconnected = asyncio.Event()
+    watcher = asyncio.create_task(_watch_disconnect(raw_request, disconnected))
+    try:
+        result = await handler.decide(request, disconnected)
+        return JSONResponse(
+            content={
+                "model": result.model,
+                "answers": result.answers,
+                "usage": {
+                    "input_tokens": result.input_tokens,
+                    "output_tokens": result.output_tokens,
+                },
+                "latency_ms": result.latency_ms,
+            }
+        )
+    except SystemOneError as exc:
+        return JSONResponse(content=exc.as_dict(), status_code=exc.status)
+    finally:
+        watcher.cancel()
+        with suppress(asyncio.CancelledError):
+            await watcher
+
+
+__all__ = ["router"]
diff --git a/vllm/entrypoints/pooling/systemone/artifact.py b/vllm/entrypoints/pooling/systemone/artifact.py
new file mode 100644
index 000000000..e9704a049
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/artifact.py
@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import hashlib
+import json
+import math
+import re
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+from .renderer import STRUCTURAL_TOKENS, Tokenizer
+
+if TYPE_CHECKING:
+    from vllm.config import ModelConfig
+
+_ARCHITECTURE = "KevQwen3ForDecision"
+_REVISION = re.compile(r"[0-9a-f]{40}")
+_SHA256 = re.compile(r"[0-9a-f]{64}")
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _file(root: Path, name: str) -> Path:
+    relative = Path(name)
+    if relative.is_absolute() or len(relative.parts) != 1 or ".." in relative.parts:
+        raise ValueError(f"invalid KEV artifact filename: {name}")
+    path = root / relative
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"missing regular KEV artifact file: {name}")
+    return path
+
+
+def validate_runtime_artifact(
+    model_config: "ModelConfig", tokenizer: Tokenizer
+) -> dict[str, Any]:
+    """Validate an exported KEV artifact before enabling its endpoint."""
+    root = Path(model_config.model).resolve()
+    if not root.is_dir():
+        raise ValueError("KEV requires a local exported artifact directory")
+    manifest_path = _file(root, "kev_manifest.json")
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if manifest.get("format_version") != 1:
+        raise ValueError("unsupported KEV artifact format")
+    if manifest.get("architecture") != _ARCHITECTURE:
+        raise ValueError("invalid KEV artifact architecture")
+    if manifest.get("option_isolation") is not False:
+        raise ValueError("option-isolation KEV artifacts are unsupported")
+    temperature = manifest.get("temperature")
+    if (
+        type(temperature) not in (int, float)
+        or not math.isfinite(temperature)
+        or temperature <= 0
+    ):
+        raise ValueError("invalid KEV artifact temperature")
+
+    sources = manifest.get("sources")
+    if not isinstance(sources, dict):
+        raise ValueError("KEV artifact source provenance is missing")  # noqa: TRY004
+    for field in ("checkpoint_revision", "base_revision", "reference_revision"):
+        revision = sources.get(field)
+        if not isinstance(revision, str) or _REVISION.fullmatch(revision) is None:
+            raise ValueError(f"KEV artifact {field} is not immutable")
+    source_checksums = sources.get("files_sha256")
+    if (
+        not isinstance(source_checksums, dict)
+        or set(source_checksums)
+        != {"adapter_config.json", "adapter_model.safetensors", "head.pt"}
+        or any(
+            not isinstance(value, str) or _SHA256.fullmatch(value) is None
+            for value in source_checksums.values()
+        )
+    ):
+        raise ValueError("KEV artifact source checksums are invalid")
+
+    checksums = manifest.get("files_sha256")
+    if not isinstance(checksums, dict) or not checksums:
+        raise ValueError("KEV artifact checksum inventory is missing")
+    required = {
+        "config.json",
+        "model.safetensors.index.json",
+        "tokenizer.json",
+        "tokenizer_config.json",
+    }
+    if not required.issubset(checksums):
+        raise ValueError("KEV artifact checksum inventory is incomplete")
+    actual_files = {
+        path.name
+        for path in root.iterdir()
+        if path.is_file() and path.name != "kev_manifest.json"
+    }
+    if set(checksums) != actual_files:
+        raise ValueError("KEV artifact checksum inventory does not match its files")
+    for name, expected in checksums.items():
+        if not isinstance(expected, str) or _SHA256.fullmatch(expected) is None:
+            raise ValueError(f"invalid KEV artifact checksum: {name}")
+        if _sha256(_file(root, name)) != expected:
+            raise ValueError(f"KEV artifact checksum mismatch: {name}")
+
+    index = json.loads((root / "model.safetensors.index.json").read_text("utf-8"))
+    weight_map = index.get("weight_map")
+    head_names = {
+        "pooler.q.weight",
+        "pooler.q.bias",
+        "pooler.k.weight",
+        "pooler.k.bias",
+    }
+    if not isinstance(weight_map, dict) or not head_names.issubset(weight_map):
+        raise ValueError("KEV artifact pointer head index is incomplete")
+    if not set(weight_map.values()).issubset(checksums):
+        raise ValueError("KEV artifact index references an unverified weight file")
+
+    hf_config = model_config.hf_config
+    if model_config.architecture != _ARCHITECTURE:
+        raise ValueError("loaded model architecture does not match KEV artifact")
+    config_fields = {
+        "kev_head_dim": "head_dim",
+        "kev_temperature": "temperature",
+        "kev_backbone_dtype": "backbone_dtype",
+    }
+    for config_field, manifest_field in config_fields.items():
+        if getattr(hf_config, config_field, None) != manifest.get(manifest_field):
+            raise ValueError(f"loaded model config mismatch: {config_field}")
+
+    actual_token_ids = {
+        token: tokenizer.convert_tokens_to_ids(token) for token in STRUCTURAL_TOKENS
+    }
+    if actual_token_ids != manifest.get("structural_token_ids"):
+        raise ValueError("loaded tokenizer does not match KEV artifact")
+    return manifest
+
+
+__all__ = ["validate_runtime_artifact"]
diff --git a/vllm/entrypoints/pooling/systemone/backend.py b/vllm/entrypoints/pooling/systemone/backend.py
new file mode 100644
index 000000000..955dcc010
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/backend.py
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import TYPE_CHECKING, Any
+
+from vllm.pooling_params import PoolingParams
+
+from .renderer import PreparedQuestion
+
+if TYPE_CHECKING:
+    from vllm.engine.protocol import EngineClient
+
+
+class EngineDecisionBackend:
+    """Adapt vLLM's pooling engine to a single KEV question branch."""
+
+    def __init__(self, engine_client: EngineClient) -> None:
+        self.engine_client = engine_client
+
+    async def infer(
+        self, request_id: str, question: PreparedQuestion
+    ) -> Sequence[float]:
+        params = PoolingParams(task="plugin", extra_kwargs=question.metadata())
+        final_output: Any | None = None
+        async for output in self.engine_client.encode(
+            {"prompt_token_ids": list(question.token_ids)},
+            params,
+            request_id,
+        ):
+            final_output = output
+        if final_output is None:
+            raise RuntimeError("pooling engine returned no output")
+        data = final_output.outputs.data
+        if hasattr(data, "detach"):
+            data = data.detach()
+        if hasattr(data, "cpu"):
+            data = data.cpu()
+        if hasattr(data, "tolist"):
+            data = data.tolist()
+        if not isinstance(data, (list, tuple)):
+            raise TypeError("KEV pooler output must be a probability sequence")
+        return [float(value) for value in data]
+
+    async def abort(self, request_ids: Sequence[str]) -> None:
+        await self.engine_client.abort(request_ids)
+
+
+__all__ = ["EngineDecisionBackend"]
