+# SPDX-License-Identifier: Apache-2.0
+
+import hashlib
+import json
+from types import SimpleNamespace
+
+import pytest
+from fastapi import FastAPI
+
+from vllm.entrypoints.pooling.factories import (
+    is_systemone_model,
+    register_pooling_api_routers,
+)
+from vllm.entrypoints.pooling.systemone.artifact import validate_runtime_artifact
+from vllm.entrypoints.pooling.systemone.renderer import STRUCTURAL_TOKENS
+
+
+def config(architecture):
+    return SimpleNamespace(
+        architecture=architecture,
+        get_pooling_task=lambda supported_tasks: "plugin" if supported_tasks else None,
+    )
+
+
+def paths(app):
+    return {route.path for route in app.routes}
+
+
+def test_systemone_route_is_only_registered_for_dedicated_architecture():
+    kev_app = FastAPI()
+    register_pooling_api_routers(kev_app, (), config("KevQwen3ForDecision"))
+    assert "/v1/systemone" in paths(kev_app)
+    assert is_systemone_model(config("KevQwen3ForDecision"))
+
+    qwen_app = FastAPI()
+    register_pooling_api_routers(qwen_app, (), config("Qwen3ForCausalLM"))
+    assert "/v1/systemone" not in paths(qwen_app)
+    assert not is_systemone_model(config("Qwen3ForCausalLM"))
+
+
+def artifact(tmp_path):
+    files = {
+        "config.json": b"{}",
+        "model.safetensors": b"backbone",
+        "kev-head.safetensors": b"head",
+        "tokenizer.json": b"{}",
+        "tokenizer_config.json": b"{}",
+    }
+    weight_map = {
+        "model.embed_tokens.weight": "model.safetensors",
+        "pooler.q.weight": "kev-head.safetensors",
+        "pooler.q.bias": "kev-head.safetensors",
+        "pooler.k.weight": "kev-head.safetensors",
+        "pooler.k.bias": "kev-head.safetensors",
+    }
+    files["model.safetensors.index.json"] = json.dumps(
+        {"weight_map": weight_map}
+    ).encode()
+    for name, value in files.items():
+        tmp_path.joinpath(name).write_bytes(value)
+    token_ids = {token: 100 + index for index, token in enumerate(STRUCTURAL_TOKENS)}
+    manifest = {
+        "format_version": 1,
+        "architecture": "KevQwen3ForDecision",
+        "option_isolation": False,
+        "temperature": 2.5,
+        "head_dim": 4,
+        "backbone_dtype": "bfloat16",
+        "structural_token_ids": token_ids,
+        "sources": {
+            "checkpoint_revision": "1" * 40,
+            "base_revision": "2" * 40,
+            "reference_revision": "3" * 40,
+            "files_sha256": {
+                "adapter_config.json": "4" * 64,
+                "adapter_model.safetensors": "5" * 64,
+                "head.pt": "6" * 64,
+            },
+        },
+        "files_sha256": {
+            name: hashlib.sha256(value).hexdigest() for name, value in files.items()
+        },
+    }
+    tmp_path.joinpath("kev_manifest.json").write_text(json.dumps(manifest))
+    model_config = SimpleNamespace(
+        model=str(tmp_path),
+        architecture="KevQwen3ForDecision",
+        hf_config=SimpleNamespace(
+            kev_head_dim=4,
+            kev_temperature=2.5,
+            kev_backbone_dtype="bfloat16",
+        ),
+    )
+    tokenizer = SimpleNamespace(convert_tokens_to_ids=token_ids.__getitem__)
+    return model_config, tokenizer
+
+
+def test_runtime_artifact_validation_gates_readiness(tmp_path):
+    model_config, tokenizer = artifact(tmp_path)
+    manifest = validate_runtime_artifact(model_config, tokenizer)
+    assert manifest["sources"]["base_revision"] == "2" * 40
+
+    tmp_path.joinpath("model.safetensors").write_bytes(b"corrupt")
+    with pytest.raises(ValueError, match="checksum mismatch: model.safetensors"):
+        validate_runtime_artifact(model_config, tokenizer)
