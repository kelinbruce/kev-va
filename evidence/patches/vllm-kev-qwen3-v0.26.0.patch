@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import httpx
+import pytest
+from fastapi import FastAPI
+
+from vllm.entrypoints.pooling.systemone.api_router import router
+
+
+class Service:
+    def __init__(self, error=None):
+        self.error = error
+        self.requests = []
+        self.errors = []
+
+    def record_error(self, code):
+        self.errors.append(code)
+
+    async def decide(self, request, disconnected):
+        self.requests.append(request)
+        if self.error is not None:
+            raise self.error
+        return SimpleNamespace(
+            model="kev-qwen3-4b",
+            answers={
+                "binary": {"type": "noul", "noul": 0.75},
+                "pick": {
+                    "type": "choice",
+                    "choice": "b",
+                    "confidence": 0.5,
+                    "probabilities": {"a": 0.25, "b": 0.75},
+                },
+                "rate": {
+                    "type": "score",
+                    "score": 1.4,
+                    "legend": {"0": "low", "1": "medium", "2": "high"},
+                    "probabilities": {"0": 0.1, "1": 0.4, "2": 0.5},
+                    "confidence": 0.55,
+                },
+            },
+            input_tokens=123,
+            output_tokens=45,
+            latency_ms=3.5,
+        )
+
+
+def payload():
+    return {
+        "model": "kev-latest",
+        "state": {"topic": "test"},
+        "questions": {
+            "binary": {"type": "noul", "instructions": "decide"},
+            "pick": {
+                "type": "choice",
+                "instructions": "pick",
+                "criteria": {"a": "first", "b": "second"},
+            },
+            "rate": {
+                "type": "score",
+                "instructions": "rate",
+                "criteria": ["low", "medium", "high"],
+            },
+        },
+    }
+
+
+async def post(app, value):
+    transport = httpx.ASGITransport(app=app)
+    async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+        return await client.post("/v1/systemone", json=value)
+
+
+@pytest.mark.asyncio
+async def test_systemone_route_returns_contract_and_usage():
+    app = FastAPI()
+    app.include_router(router)
+    service = Service()
+    app.state.serving_systemone = service
+    response = await post(app, payload())
+
+    assert response.status_code == 200
+    assert response.json()["model"] == "kev-qwen3-4b"
+    assert list(response.json()["answers"]) == ["binary", "pick", "rate"]
+    assert response.json()["usage"] == {"input_tokens": 123, "output_tokens": 45}
+    assert response.json()["latency_ms"] == 3.5
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "mutate",
+    [
+        lambda value: value.update({"unknown": True}),
+        lambda value: value["questions"]["pick"].update({"unknown": True}),
+        lambda value: value.update({"questions": {}}),
+    ],
+)
+async def test_systemone_route_returns_structured_validation_errors(mutate):
+    app = FastAPI()
+    app.include_router(router)
+    service = Service()
+    app.state.serving_systemone = service
+    value = payload()
+    mutate(value)
+    response = await post(app, value)
+
+    assert response.status_code == 422
+    assert response.json()["error"]["type"] == "invalid_request_error"
+    assert response.json()["error"]["code"] == "invalid_request"
+    assert response.json()["error"]["param"] is None
+    assert service.errors == ["invalid_request"]
+
+
+@pytest.mark.asyncio
+async def test_systemone_route_is_unavailable_without_service():
+    app = FastAPI()
+    app.include_router(router)
+    response = await post(app, payload())
+    assert response.status_code == 404
+    assert response.json()["error"]["code"] == "unsupported_endpoint"
