+# SPDX-License-Identifier: Apache-2.0
+
+import math
+from collections.abc import Set
+from typing import Any
+
+import torch
+import torch.nn as nn
+
+from vllm.pooling_params import PoolingParams
+from vllm.tasks import PoolingTask
+from vllm.v1.outputs import PoolerOutput
+from vllm.v1.pool.metadata import PoolingMetadata
+
+from .abstract import Pooler
+
+METADATA_VERSION = 1
+
+
+def _read_metadata(value: dict[str, Any] | None, sequence_length: int):
+    if value is None:
+        raise ValueError("KEV pooling metadata is required")
+    if value.get("version") != METADATA_VERSION:
+        raise ValueError("unsupported KEV pooling metadata version")
+    if set(value) != {"version", "option_end_indices", "decision_index"}:
+        raise ValueError("invalid KEV pooling metadata fields")
+
+    option_indices = value["option_end_indices"]
+    decision_index = value["decision_index"]
+    if (
+        not isinstance(option_indices, list)
+        or not option_indices
+        or any(type(index) is not int for index in option_indices)
+    ):
+        raise ValueError("option_end_indices must be a non-empty integer list")
+    if type(decision_index) is not int:
+        raise ValueError("decision_index must be an integer")
+    indices = [*option_indices, decision_index]
+    if any(index < 0 or index >= sequence_length for index in indices):
+        raise ValueError("KEV pooling index is outside the sequence")
+    if len(set(option_indices)) != len(option_indices):
+        raise ValueError("option_end_indices must be unique")
+    return option_indices, decision_index
+
+
+class KevPooler(Pooler):
+    def __init__(
+        self,
+        hidden_size: int,
+        head_dim: int,
+        temperature: float = 1.0,
+    ) -> None:
+        super().__init__()
+        if hidden_size <= 0 or head_dim <= 0:
+            raise ValueError("hidden_size and head_dim must be positive")
+        if not math.isfinite(temperature) or temperature <= 0:
+            raise ValueError("temperature must be finite and positive")
+        self.q = nn.Linear(hidden_size, head_dim, dtype=torch.float32)
+        self.k = nn.Linear(hidden_size, head_dim, dtype=torch.float32)
+        self.scale = 1 / math.sqrt(head_dim)
+        self.temperature = temperature
+
+    def get_supported_tasks(self) -> Set[PoolingTask]:
+        return {"plugin"}
+
+    def get_dummy_pooling_params(self, task: PoolingTask) -> PoolingParams:
+        if task != "plugin":
+            raise ValueError(f"unsupported KEV pooling task: {task}")
+        return PoolingParams(
+            task="plugin",
+            extra_kwargs={
+                "version": METADATA_VERSION,
+                "option_end_indices": [0],
+                "decision_index": 0,
+            },
+        )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        pooling_metadata: PoolingMetadata,
+    ) -> PoolerOutput:
+        if hidden_states.ndim != 2:
+            raise ValueError("KEV pooler expects flattened token hidden states")
+        cursor = pooling_metadata.get_pooling_cursor()
+        if len(pooling_metadata.pooling_params) != len(cursor.seq_lens_cpu):
+            raise ValueError("KEV metadata count does not match the batch")
+
+        option_indices = []
+        decision_indices = []
+        option_counts = []
+        for params, sequence_length in zip(
+            pooling_metadata.pooling_params, cursor.seq_lens_cpu
+        ):
+            options, decision = _read_metadata(
+                params.extra_kwargs, int(sequence_length)
+            )
+            option_indices.extend(options)
+            decision_indices.append(decision)
+            option_counts.append(len(options))
+
+        device = hidden_states.device
+        first_indices = cursor.first_token_indices_gpu.to(dtype=torch.long)
+        decision_indices_gpu = torch.tensor(
+            decision_indices, dtype=torch.long, device=device
+        )
+        option_indices_gpu = torch.tensor(
+            option_indices, dtype=torch.long, device=device
+        )
+        option_counts_gpu = torch.tensor(option_counts, dtype=torch.long, device=device)
+        global_decision_indices = first_indices + decision_indices_gpu
+        global_option_indices = (
+            first_indices.repeat_interleave(option_counts_gpu) + option_indices_gpu
+        )
+
+        decision_states = hidden_states[global_decision_indices].float()
+        option_states = hidden_states[global_option_indices].float()
+        queries = self.q(decision_states).repeat_interleave(option_counts_gpu, dim=0)
+        keys = self.k(option_states)
+        logits = (queries * keys).sum(dim=-1) * self.scale / self.temperature
+        return [part.softmax(dim=-1) for part in logits.split(option_counts)]
+
+
+__all__ = ["KevPooler"]
