@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import pytest
+
+from vllm.entrypoints.pooling.systemone.renderer import PreparedQuestion
+from vllm.entrypoints.pooling.systemone.responses import (
+    answer_from_probabilities,
+    answers_from_probabilities,
+    serialized_output_tokens,
+)
+
+
+def prepared(question_id, question_type, keys, legend=None):
+    return PreparedQuestion(
+        question_id=question_id,
+        question_type=question_type,
+        keys=tuple(keys),
+        token_ids=(1,),
+        position_ids=(0,),
+        option_end_indices=(0,) * len(keys),
+        decision_index=0,
+        legend=legend,
+    )
+
+
+def test_noul_and_score_match_fixed_kev_golden_values():
+    questions = [
+        prepared("boolean", "noul", ["false", "true"]),
+        prepared(
+            "ordinal",
+            "score",
+            ["0", "1", "2"],
+            {"0": "low", "1": "medium", "2": "high"},
+        ),
+    ]
+
+    assert answers_from_probabilities(questions, [[0.05, 0.95], [0.1, 0.7, 0.2]]) == {
+        "boolean": {"type": "noul", "noul": 0.95},
+        "ordinal": {
+            "type": "score",
+            "score": 1.1,
+            "legend": {"0": "low", "1": "medium", "2": "high"},
+            "probabilities": {"0": 0.1, "1": 0.7, "2": 0.2},
+            "confidence": 0.85,
+        },
+    }
+
+
+def test_choice_uses_raw_probabilities_before_rounding_and_stable_ties():
+    question = prepared("choice", "choice", ["a", "b"])
+
+    rounded_tie = answer_from_probabilities(question, [0.499, 0.501])
+    exact_tie = answer_from_probabilities(question, [0.5, 0.5])
+
+    assert rounded_tie["probabilities"] == {"a": 0.5, "b": 0.5}
+    assert rounded_tie["choice"] == "b"
+    assert exact_tie["choice"] == "a"
+
+
+def test_single_choice_confidence_is_one():
+    question = prepared("choice", "choice", ["only"])
+
+    assert answer_from_probabilities(question, [1.0])["confidence"] == 1.0
+
+
+@pytest.mark.parametrize(
+    "probabilities",
+    [[0.2, 0.2], [0.5, float("nan")], [1.1, -0.1], [1.0]],
+)
+def test_invalid_probability_distributions_are_rejected(probabilities):
+    question = prepared("choice", "choice", ["a", "b"])
+
+    with pytest.raises(ValueError):
+        answer_from_probabilities(question, probabilities)
+
+
+def test_result_count_must_match_questions():
+    question = prepared("choice", "choice", ["a"])
+
+    with pytest.raises(ValueError, match="count"):
+        answers_from_probabilities([question], [])
+
+
+def test_output_usage_counts_fixed_kev_json_serialization():
+    class RecordingTokenizer:
+        def __call__(self, text, *, add_special_tokens):
+            assert text == '{"q": {"probabilities": {"a": 0.33, "b": 0.67}}}'
+            assert add_special_tokens is False
+            return type("Tokens", (), {"input_ids": [1, 2, 3, 4]})()
+
+    answers = {"q": {"probabilities": {"a": 0.33, "b": 0.67}}}
+    assert serialized_output_tokens(RecordingTokenizer(), answers) == 4
+
+
+def test_display_probabilities_are_not_renormalized_after_rounding():
+    question = prepared("choice", "choice", ["a", "b", "c"])
+    answer = answer_from_probabilities(question, [0.334, 0.333, 0.333])
+    assert answer["probabilities"] == {"a": 0.33, "b": 0.33, "c": 0.33}
+    assert sum(answer["probabilities"].values()) == pytest.approx(0.99)
