@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.entrypoints.pooling.systemone.backend import EngineDecisionBackend
+from vllm.entrypoints.pooling.systemone.renderer import PreparedQuestion
+
+
+def question():
+    return PreparedQuestion(
+        question_id="q",
+        question_type="choice",
+        keys=("a", "b"),
+        token_ids=(10, 11, 12),
+        position_ids=(0, 1, 2),
+        option_end_indices=(1, 2),
+        decision_index=2,
+    )
+
+
+class Engine:
+    def __init__(self, outputs=None):
+        self.outputs = (torch.tensor([0.25, 0.75]),) if outputs is None else outputs
+        self.calls = []
+        self.aborted = []
+
+    async def encode(self, prompt, params, request_id):
+        self.calls.append((prompt, params, request_id))
+        for output in self.outputs:
+            yield SimpleNamespace(outputs=SimpleNamespace(data=output))
+
+    async def abort(self, request_ids):
+        self.aborted.append(request_ids)
+
+
+@pytest.mark.asyncio
+async def test_engine_backend_submits_tokens_and_metadata():
+    engine = Engine()
+    backend = EngineDecisionBackend(engine)
+    result = await backend.infer("parent/0", question())
+
+    assert result == [0.25, 0.75]
+    prompt, params, request_id = engine.calls[0]
+    assert prompt == {"prompt_token_ids": [10, 11, 12]}
+    assert request_id == "parent/0"
+    assert params.task == "plugin"
+    assert params.extra_kwargs == {
+        "version": 1,
+        "option_end_indices": [1, 2],
+        "decision_index": 2,
+    }
+
+
+@pytest.mark.asyncio
+async def test_engine_backend_uses_last_output_and_forwards_abort():
+    engine = Engine((torch.tensor([1.0, 0.0]), torch.tensor([0.0, 1.0])))
+    backend = EngineDecisionBackend(engine)
+    assert await backend.infer("request", question()) == [0.0, 1.0]
+    await backend.abort(("request", "sibling"))
+    assert engine.aborted == [("request", "sibling")]
+
+
+@pytest.mark.asyncio
+async def test_engine_backend_rejects_missing_output():
+    backend = EngineDecisionBackend(Engine(()))
+    with pytest.raises(RuntimeError, match="no output"):
+        await backend.infer("request", question())
