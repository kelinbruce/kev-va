+# SPDX-License-Identifier: Apache-2.0
+
+import math
+import time
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.model_executor.layers.pooler.kev import KevPooler
+from vllm.pooling_params import PoolingParams
+from vllm.v1.engine import EngineCoreRequest
+from vllm.v1.pool.metadata import PoolingMetadata, PoolingStates
+from vllm.v1.serial_utils import MsgpackDecoder, MsgpackEncoder
+
+
+def metadata(sequence_lengths, option_indices, decision_indices):
+    params = [
+        PoolingParams(
+            task="plugin",
+            extra_kwargs={
+                "version": 1,
+                "option_end_indices": options,
+                "decision_index": decision,
+            },
+        )
+        for options, decision in zip(option_indices, decision_indices)
+    ]
+    lengths = torch.tensor(sequence_lengths, dtype=torch.long)
+    value = PoolingMetadata(
+        prompt_lens=lengths,
+        prompt_token_ids=None,
+        prompt_token_ids_cpu=None,
+        pooling_params=params,
+        pooling_states=[PoolingStates() for _ in params],
+    )
+    value.build_pooling_cursor(np.array(sequence_lengths), lengths, torch.device("cpu"))
+    return value
+
+
+def test_pointer_probabilities_match_fp32_reference_for_ragged_batch():
+    torch.manual_seed(1)
+    option_counts = [1, 2, 8, 255]
+    sequence_lengths = [count + 3 for count in option_counts]
+    option_indices = [list(range(1, count + 1)) for count in option_counts]
+    decision_indices = [length - 1 for length in sequence_lengths]
+    hidden_states = torch.randn(sum(sequence_lengths), 5, dtype=torch.bfloat16)
+    pooler = KevPooler(hidden_size=5, head_dim=3, temperature=2.3)
+
+    with torch.no_grad():
+        pooler.q.weight.copy_(torch.randn_like(pooler.q.weight))
+        pooler.q.bias.copy_(torch.randn_like(pooler.q.bias))
+        pooler.k.weight.copy_(torch.randn_like(pooler.k.weight))
+        pooler.k.bias.copy_(torch.randn_like(pooler.k.bias))
+
+    outputs = pooler(
+        hidden_states,
+        metadata(sequence_lengths, option_indices, decision_indices),
+    )
+    offsets = [0]
+    for length in sequence_lengths:
+        offsets.append(offsets[-1] + length)
+    for batch_index, output in enumerate(outputs):
+        start = offsets[batch_index]
+        decision = hidden_states[start + decision_indices[batch_index]].float()
+        options = hidden_states[
+            torch.tensor(option_indices[batch_index]) + start
+        ].float()
+        logits = pooler.k(options) @ pooler.q(decision) / math.sqrt(3) / 2.3
+        expected = logits.softmax(dim=-1)
+        torch.testing.assert_close(output, expected, atol=1e-5, rtol=1e-5)
+        assert output.shape == (option_counts[batch_index],)
+        assert torch.isfinite(output).all()
+        torch.testing.assert_close(output.sum(), torch.tensor(1.0))
+
+
+def test_pointer_head_stays_fp32_and_keeps_biases():
+    pooler = KevPooler(hidden_size=4, head_dim=2)
+
+    assert pooler.q.weight.dtype == torch.float32
+    assert pooler.k.weight.dtype == torch.float32
+    assert pooler.q.bias is not None
+    assert pooler.k.bias is not None
+
+
+def test_batch_reordering_preserves_ragged_question_results():
+    torch.manual_seed(7)
+    blocks = [torch.randn(5, 4), torch.randn(8, 4), torch.randn(4, 4)]
+    options = [[1, 2], [1, 3, 5, 6], [1]]
+    decisions = [4, 7, 3]
+    pooler = KevPooler(hidden_size=4, head_dim=3, temperature=1.7)
+
+    def run(order):
+        outputs = pooler(
+            torch.cat([blocks[index] for index in order]),
+            metadata(
+                [len(blocks[index]) for index in order],
+                [options[index] for index in order],
+                [decisions[index] for index in order],
+            ),
+        )
+        return {index: output for index, output in zip(order, outputs)}
+
+    original = run([0, 1, 2])
+    reordered = run([2, 0, 1])
+
+    for index in original:
+        torch.testing.assert_close(reordered[index], original[index])
+        torch.testing.assert_close(original[index].sum(), torch.tensor(1.0))
+
+
+@pytest.mark.parametrize(
+    ("extra_kwargs", "match"),
+    [
+        (None, "required"),
+        (
+            {
+                "version": 2,
+                "option_end_indices": [1],
+                "decision_index": 2,
+            },
+            "version",
+        ),
+        (
+            {
+                "version": 1,
+                "option_end_indices": [],
+                "decision_index": 2,
+            },
+            "non-empty",
+        ),
+        (
+            {
+                "version": 1,
+                "option_end_indices": [1],
+                "decision_index": 9,
+            },
+            "outside",
+        ),
+    ],
+)
+def test_invalid_metadata_is_rejected(extra_kwargs, match):
+    value = metadata([4], [[1]], [3])
+    value.pooling_params[0].extra_kwargs = extra_kwargs
+
+    with pytest.raises(ValueError, match=match):
+        KevPooler(hidden_size=3, head_dim=2)(torch.randn(4, 3), value)
+
+
+@pytest.mark.parametrize("temperature", [0.0, -1.0, float("nan")])
+def test_invalid_temperature_is_rejected(temperature):
+    with pytest.raises(ValueError, match="temperature"):
+        KevPooler(hidden_size=3, head_dim=2, temperature=temperature)
+
+
+def test_dummy_profiling_metadata_is_valid_for_any_nonempty_sequence():
+    pooler = KevPooler(hidden_size=3, head_dim=2)
+    params = pooler.get_dummy_pooling_params("plugin")
+    value = metadata([1, 3], [[0], [0, 0, 0]], [0, 2])
+    value.pooling_params = [params, params]
+
+    outputs = pooler(torch.randn(4, 3), value)
+    assert [output.tolist() for output in outputs] == [[1.0], [1.0]]
+
+
+def test_plugin_metadata_survives_engine_process_boundary_for_ragged_outputs(
+    monkeypatch,
+):
+    monkeypatch.setattr("vllm.v1.pool.metadata.PIN_MEMORY", False)
+    specs = [
+        ("parent-a/0", 5, [1, 2], 4),
+        ("parent-b/3", 7, [1, 3, 5], 6),
+    ]
+    requests = [
+        EngineCoreRequest(
+            request_id=request_id,
+            prompt_token_ids=list(range(sequence_length)),
+            mm_features=None,
+            sampling_params=None,
+            pooling_params=PoolingParams(
+                task="plugin",
+                extra_kwargs={
+                    "version": 1,
+                    "option_end_indices": option_indices,
+                    "decision_index": decision_index,
+                },
+            ),
+            arrival_time=time.time(),
+            lora_request=None,
+            cache_salt=None,
+            data_parallel_rank=None,
+        )
+        for request_id, sequence_length, option_indices, decision_index in specs
+    ]
+    encoder = MsgpackEncoder()
+    decoder = MsgpackDecoder(EngineCoreRequest)
+    decoded = [decoder.decode(encoder.encode(request)) for request in requests]
+
+    assert [request.request_id for request in decoded] == [
+        "parent-a/0",
+        "parent-b/3",
+    ]
+    assert [request.pooling_params.extra_kwargs for request in decoded] == [
+        {
+            "version": 1,
+            "option_end_indices": [1, 2],
+            "decision_index": 4,
+        },
+        {
+            "version": 1,
+            "option_end_indices": [1, 3, 5],
+            "decision_index": 6,
+        },
+    ]
+
+    value = metadata([5, 7], [[1, 2], [1, 3, 5]], [4, 6])
+    value.pooling_params = [request.pooling_params for request in decoded]
+    outputs = KevPooler(hidden_size=4, head_dim=3)(torch.randn(12, 4), value)
+    by_request = {
+        request.request_id: output for request, output in zip(decoded, outputs)
+    }
+
+    assert by_request["parent-a/0"].shape == (2,)
+    assert by_request["parent-b/3"].shape == (3,)
+    for output in by_request.values():
+        torch.testing.assert_close(output.sum(), torch.tensor(1.0))
