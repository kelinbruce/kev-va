@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: Apache-2.0
+
+"""Decision-only Qwen3 model with the trained KEV pointer head."""
+
+import math
+from collections.abc import Iterable
+
+import torch
+from torch import nn
+
+from vllm.config import VllmConfig
+from vllm.model_executor.layers.pooler import KevPooler, Pooler
+from vllm.sequence import IntermediateTensors
+
+from .interfaces import SupportsPP
+from .qwen3 import Qwen3Model
+from .utils import AutoWeightsLoader, maybe_prefix
+
+SUPPORTED_BACKBONE_DTYPES = {
+    "bfloat16": torch.bfloat16,
+    "float16": torch.float16,
+}
+
+
+def validate_kev_runtime_config(vllm_config: VllmConfig) -> None:
+    """Reject execution modes outside the first validated KEV profile."""
+    model_config = vllm_config.model_config
+    dtype_name = getattr(model_config.hf_config, "kev_backbone_dtype", None)
+    expected_dtype = SUPPORTED_BACKBONE_DTYPES.get(dtype_name)
+    if expected_dtype is None or model_config.dtype != expected_dtype:
+        raise ValueError(
+            "KEV requires explicit matching kev_backbone_dtype "
+            "('bfloat16' or 'float16')"
+        )
+    parallel_config = vllm_config.parallel_config
+    if (
+        parallel_config.tensor_parallel_size != 1
+        or parallel_config.pipeline_parallel_size != 1
+    ):
+        raise ValueError("KEV first release requires single-device TP=1 and PP=1")
+    if not model_config.enforce_eager:
+        raise ValueError("KEV first release requires eager execution")
+    if vllm_config.cache_config.enable_prefix_caching:
+        raise ValueError("KEV first release does not support prefix caching")
+    if vllm_config.scheduler_config.enable_chunked_prefill:
+        raise ValueError("KEV first release does not support chunked prefill")
+    if vllm_config.quant_config is not None:
+        raise ValueError("KEV first release does not support quantization")
+    if vllm_config.lora_config is not None:
+        raise ValueError("KEV first release does not support runtime LoRA")
+    max_branch_tokens = getattr(model_config.hf_config, "kev_max_branch_tokens", 8192)
+    if vllm_config.scheduler_config.max_num_batched_tokens < max_branch_tokens:
+        raise ValueError(
+            "max_num_batched_tokens must cover the complete KEV branch limit"
+        )
+
+
+class KevQwen3ForDecision(nn.Module, SupportsPP):
+    """Qwen3 decoder backbone that only exposes KEV probability pooling."""
+
+    is_pooling_model = True
+    pooler: Pooler
+    hf_to_vllm_mapper = Qwen3Model.hf_to_vllm_mapper
+    packed_modules_mapping = {
+        "qkv_proj": ["q_proj", "k_proj", "v_proj"],
+        "gate_up_proj": ["gate_proj", "up_proj"],
+    }
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        validate_kev_runtime_config(vllm_config)
+        config = vllm_config.model_config.hf_config
+        head_dim = getattr(config, "kev_head_dim", None)
+        temperature = getattr(config, "kev_temperature", None)
+        if type(head_dim) is not int or head_dim <= 0:
+            raise ValueError("config.kev_head_dim must be a positive integer")
+        if (
+            not isinstance(temperature, int | float)
+            or isinstance(temperature, bool)
+            or not math.isfinite(temperature)
+            or temperature <= 0
+        ):
+            raise ValueError("config.kev_temperature must be finite and positive")
+
+        self.config = config
+        self.vllm_config = vllm_config
+        self.model = Qwen3Model(
+            vllm_config=vllm_config, prefix=maybe_prefix(prefix, "model")
+        )
+        self.pooler = KevPooler(
+            hidden_size=config.hidden_size,
+            head_dim=head_dim,
+            temperature=float(temperature),
+        )
+        self.make_empty_intermediate_tensors = (
+            self.model.make_empty_intermediate_tensors
+        )
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.model.embed_input_ids(input_ids)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor | None,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+    ) -> torch.Tensor | IntermediateTensors:
+        return self.model(input_ids, positions, intermediate_tensors, inputs_embeds)
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        loader = AutoWeightsLoader(self, ignore_unexpected_prefixes=["lm_head."])
+        return loader.load_weights(weights)
+
+
+__all__ = ["KevQwen3ForDecision", "validate_kev_runtime_config"]
