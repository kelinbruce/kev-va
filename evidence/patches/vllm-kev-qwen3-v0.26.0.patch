@@ -0,0 +1,333 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.entrypoints.pooling.systemone.protocol import SystemOneRequest
+from vllm.entrypoints.pooling.systemone.renderer import STRUCTURAL_TOKENS, Limits
+from vllm.entrypoints.pooling.systemone.serving import SystemOneError, SystemOneService
+
+
+class CharacterTokenizer:
+    structural_ids = {
+        token: 1000 + index for index, token in enumerate(STRUCTURAL_TOKENS)
+    }
+
+    def __call__(self, text, *, add_special_tokens):
+        return SimpleNamespace(input_ids=[ord(character) for character in text])
+
+    def convert_tokens_to_ids(self, token):
+        return self.structural_ids.get(token, -1)
+
+
+class Backend:
+    def __init__(self):
+        self.calls = []
+        self.aborted = []
+        self.release = asyncio.Event()
+        self.release.set()
+        self.fail_question = None
+        self.active = 0
+        self.max_active = 0
+        self.active_by_parent = {}
+        self.max_active_by_parent = {}
+        self.delays = {}
+        self.probabilities_from_state = False
+
+    async def infer(self, request_id, question):
+        parent_id = request_id.rsplit("/", 1)[0]
+        self.calls.append((request_id, question.question_id))
+        self.active += 1
+        self.max_active = max(self.max_active, self.active)
+        self.active_by_parent[parent_id] = self.active_by_parent.get(parent_id, 0) + 1
+        self.max_active_by_parent[parent_id] = max(
+            self.max_active_by_parent.get(parent_id, 0),
+            self.active_by_parent[parent_id],
+        )
+        try:
+            await self.release.wait()
+            await asyncio.sleep(self.delays.get(question.question_id, 0))
+            if question.question_id == self.fail_question:
+                raise RuntimeError("injected failure")
+            if len(question.keys) == 1:
+                return [1.0]
+            if self.probabilities_from_state:
+                return (
+                    [0.75, 0.25] if question.token_ids[1] == ord("f") else [0.25, 0.75]
+                )
+            return [0.25, 0.75] + [0.0] * (len(question.keys) - 2)
+        finally:
+            self.active -= 1
+            self.active_by_parent[parent_id] -= 1
+
+    async def abort(self, request_ids):
+        self.aborted.append(tuple(request_ids))
+        self.release.set()
+
+
+class Metrics:
+    def __init__(self):
+        self.requests = 0
+        self.branches = 0
+        self.queue_seconds = []
+        self.durations = []
+        self.successes = []
+        self.errors = []
+
+    def request_started(self):
+        self.requests += 1
+
+    def request_finished(self, duration_seconds):
+        self.requests -= 1
+        self.durations.append(duration_seconds)
+
+    def branch_started(self, queue_seconds):
+        self.branches += 1
+        self.queue_seconds.append(queue_seconds)
+
+    def branch_finished(self):
+        self.branches -= 1
+
+    def request_succeeded(self, logical_tokens, actual_tokens, questions):
+        self.successes.append((logical_tokens, actual_tokens, questions))
+
+    def request_failed(self, code):
+        self.errors.append(code)
+
+
+def request(state="state", question_ids=("one", "two")):
+    return SystemOneRequest.model_validate(
+        {
+            "model": "kev-latest",
+            "state": state,
+            "questions": {
+                question_id: {
+                    "type": "choice",
+                    "instructions": question_id,
+                    "criteria": {"a": "first", "b": "second"},
+                }
+                for question_id in question_ids
+            },
+        }
+    )
+
+
+def service(backend, **kwargs):
+    value = SystemOneService(
+        backend,
+        CharacterTokenizer(),
+        "kev-qwen3-4b",
+        **kwargs,
+    )
+    value.set_ready(True)
+    return value
+
+
+@pytest.mark.asyncio
+async def test_warmup_requires_a_valid_model_decision_before_readiness():
+    backend = Backend()
+    value = SystemOneService(backend, CharacterTokenizer(), "kev-qwen3-4b")
+    try:
+        assert value.ready is False
+        await value.warmup()
+        assert value.ready is True
+        assert backend.calls[0][1] == "warmup"
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_failed_warmup_keeps_endpoint_unready_and_aborts_request():
+    backend = Backend()
+    backend.fail_question = "warmup"
+    value = SystemOneService(backend, CharacterTokenizer(), "kev-qwen3-4b")
+    try:
+        with pytest.raises(RuntimeError, match="injected failure"):
+            await value.warmup()
+        assert value.ready is False
+        assert value.readiness_error == "RuntimeError"
+        assert backend.aborted[0][0].startswith("systemone-warmup-")
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_unknown_model_and_not_ready_reject_without_submission():
+    backend = Backend()
+    value = service(backend)
+    try:
+        unknown = request().model_copy(update={"model": "unknown"})
+        with pytest.raises(SystemOneError) as missing:
+            await value.decide(unknown)
+        assert missing.value.status == 404
+
+        value.set_ready(False)
+        with pytest.raises(SystemOneError) as unavailable:
+            await value.decide(request())
+        assert unavailable.value.status == 503
+        assert backend.calls == []
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_full_request_is_validated_before_any_child_submission():
+    backend = Backend()
+    value = service(backend, limits=Limits(max_branch_tokens=25))
+    invalid = request(question_ids=("ok", "this-question-is-too-long"))
+    try:
+        with pytest.raises(SystemOneError) as caught:
+            await value.decide(invalid)
+        assert caught.value.status == 422
+        assert backend.calls == []
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_out_of_order_parents_with_same_question_id_do_not_mix_results():
+    backend = Backend()
+    backend.probabilities_from_state = True
+    value = service(backend, global_children=2, per_parent_children=1)
+    try:
+        first, second = await asyncio.gather(
+            value.decide(request("first", ("same",))),
+            value.decide(request("second", ("same",))),
+        )
+        assert first.answers["same"]["choice"] == "a"
+        assert second.answers["same"]["choice"] == "b"
+        assert first.input_tokens != second.input_tokens
+        assert first.output_tokens > 0
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_success_metrics_include_tokens_questions_queue_and_duration():
+    backend = Backend()
+    metrics = Metrics()
+    value = service(backend, metrics=metrics)
+    try:
+        result = await value.decide(request())
+        assert metrics.successes == [
+            (result.input_tokens, result.actual_input_tokens, 2)
+        ]
+        assert metrics.errors == []
+        assert len(metrics.queue_seconds) == 2
+        assert len(metrics.durations) == 1
+        assert metrics.requests == 0
+        assert metrics.branches == 0
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_out_of_order_children_are_aggregated_in_input_order():
+    backend = Backend()
+    backend.delays["slow"] = 0.02
+    value = service(backend, global_children=2, per_parent_children=2)
+    try:
+        result = await value.decide(request(question_ids=("slow", "fast")))
+        assert list(result.answers) == ["slow", "fast"]
+        assert [question_id for _, question_id in backend.calls] == ["slow", "fast"]
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_scheduler_gives_concurrent_parents_turns():
+    backend = Backend()
+    backend.release.clear()
+    value = service(backend, global_children=2, per_parent_children=1)
+    first = asyncio.create_task(value.decide(request(question_ids=("a0", "a1"))))
+    second = asyncio.create_task(value.decide(request(question_ids=("b0", "b1"))))
+    try:
+        while len(backend.calls) < 2:
+            await asyncio.sleep(0)
+        assert {question_id for _, question_id in backend.calls[:2]} == {"a0", "b0"}
+    finally:
+        backend.release.set()
+        await asyncio.gather(first, second)
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_parent_and_child_capacity_limits_are_enforced():
+    backend = Backend()
+    backend.release.clear()
+    value = service(
+        backend,
+        max_parents=1,
+        global_children=2,
+        per_parent_children=1,
+    )
+    first = asyncio.create_task(value.decide(request(question_ids=("a", "b", "c"))))
+    try:
+        while not backend.calls:
+            await asyncio.sleep(0)
+        with pytest.raises(SystemOneError) as caught:
+            await value.decide(request(question_ids=("other",)))
+        assert caught.value.status == 429
+        assert backend.max_active <= 2
+        assert max(backend.max_active_by_parent.values()) <= 1
+    finally:
+        backend.release.set()
+        await first
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_branch_failure_aborts_siblings_and_service_recovers():
+    backend = Backend()
+    backend.fail_question = "bad"
+    value = service(backend, global_children=2, per_parent_children=2)
+    try:
+        with pytest.raises(SystemOneError) as caught:
+            await value.decide(request(question_ids=("bad", "sibling")))
+        assert caught.value.status == 500
+        assert backend.aborted
+
+        backend.fail_question = None
+        result = await value.decide(request(question_ids=("recovered",)))
+        assert result.answers["recovered"]["choice"] == "b"
+    finally:
+        await value.close()
+
+
+@pytest.mark.asyncio
+async def test_timeout_and_disconnect_abort_all_children():
+    backend = Backend()
+    backend.release.clear()
+    metrics = Metrics()
+    value = service(
+        backend,
+        global_children=2,
+        per_parent_children=2,
+        deadline_seconds=0.02,
+        metrics=metrics,
+    )
+    try:
+        with pytest.raises(SystemOneError) as timeout:
+            await value.decide(request())
+        assert timeout.value.status == 504
+        assert backend.aborted
+
+        backend.release.clear()
+        disconnected = asyncio.Event()
+        task = asyncio.create_task(value.decide(request(), disconnected))
+        while len(backend.calls) < 3:
+            await asyncio.sleep(0)
+        disconnected.set()
+        with pytest.raises(SystemOneError) as cancelled:
+            await task
+        assert cancelled.value.status == 499
+        assert len(backend.aborted) == 2
+        assert metrics.successes == []
+        assert metrics.errors == ["deadline_exceeded", "client_disconnected"]
+        assert metrics.requests == 0
+        assert metrics.branches == 0
+    finally:
+        backend.release.set()
+        await value.close()
