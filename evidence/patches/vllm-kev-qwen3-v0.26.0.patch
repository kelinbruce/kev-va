new file mode 100644
index 000000000..84a82fa88
--- /dev/null
+++ b/tests/entrypoints/pooling/systemone/test_protocol.py
@@ -0,0 +1,179 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import pytest
+from pydantic import ValidationError
+
+from vllm.entrypoints.pooling.systemone.protocol import SystemOneRequest
+from vllm.entrypoints.pooling.systemone.renderer import (
+    STRUCTURAL_TOKENS,
+    Limits,
+    prepare_questions,
+    prepare_request,
+    render_json,
+)
+
+
+class CharacterTokenizer:
+    structural_ids = {
+        token: 1000 + index for index, token in enumerate(STRUCTURAL_TOKENS)
+    }
+
+    def __call__(self, text, *, add_special_tokens):
+        assert add_special_tokens is False
+        return SimpleNamespace(input_ids=[ord(character) for character in text])
+
+    def convert_tokens_to_ids(self, token):
+        return self.structural_ids.get(token, -1)
+
+
+def request(**changes):
+    payload = {
+        "state": {"中文": [True, None, {"count": 2}]},
+        "questions": {
+            "choice": {
+                "type": "choice",
+                "instructions": "pick <|fim_suffix|>",
+                "criteria": {"a": "first", "b": {"nested": False}},
+            },
+            "noul": {
+                "type": "noul",
+                "instructions": "is valid?",
+            },
+            "score": {
+                "type": "score",
+                "instructions": ["rate", 3],
+                "criteria": ["low", "high"],
+            },
+        },
+    }
+    payload.update(changes)
+    return SystemOneRequest.model_validate(payload)
+
+
+def test_protocol_rejects_unknown_fields_and_non_finite_values():
+    with pytest.raises(ValidationError, match="extra_forbidden"):
+        request(stream=True)
+    with pytest.raises(ValidationError, match="finite"):
+        request(state={"nested": [float("nan")]})
+
+
+@pytest.mark.parametrize(
+    "question",
+    [
+        {"type": "choice", "instructions": "x", "criteria": {}},
+        {"type": "score", "instructions": "x", "criteria": ["only"]},
+        {
+            "type": "noul",
+            "instructions": "x",
+            "criteria": {"maybe": "unknown"},
+        },
+    ],
+)
+def test_protocol_rejects_invalid_question_shapes(question):
+    with pytest.raises(ValidationError):
+        request(questions={"invalid": question})
+
+
+def test_rendering_matches_fixed_kev_rules():
+    assert render_json({"a": [True, None], "b": {"c": 2}}) == (
+        "a:\n  - True\n  - \nb:\n  c: 2"
+    )
+
+
+def test_prepared_questions_have_isolated_sequences_and_readout_indices():
+    tokenizer = CharacterTokenizer()
+    prepared = prepare_questions(request(), tokenizer)
+
+    assert [item.question_id for item in prepared] == ["choice", "noul", "score"]
+    assert [item.keys for item in prepared] == [
+        ("a", "b"),
+        ("false", "true"),
+        ("0", "1"),
+    ]
+    for item in prepared:
+        assert item.token_ids[0] == tokenizer.structural_ids[STRUCTURAL_TOKENS[0]]
+        assert item.token_ids[-1] == tokenizer.structural_ids[STRUCTURAL_TOKENS[4]]
+        assert item.position_ids == tuple(range(len(item.token_ids)))
+        assert item.decision_index == len(item.token_ids) - 1
+        assert all(
+            item.token_ids[index] == tokenizer.structural_ids[STRUCTURAL_TOKENS[3]]
+            for index in item.option_end_indices
+        )
+    decision_token_id = tokenizer.structural_ids[STRUCTURAL_TOKENS[4]]
+    assert decision_token_id not in prepared[0].token_ids[:-1]
+
+
+def test_question_id_is_mapping_only():
+    tokenizer = CharacterTokenizer()
+    original = request()
+    renamed = request(
+        questions={
+            "renamed": original.questions["choice"].model_dump(),
+        }
+    )
+    original_branch = prepare_questions(
+        request(questions={"choice": original.questions["choice"].model_dump()}),
+        tokenizer,
+    )[0]
+    renamed_branch = prepare_questions(renamed, tokenizer)[0]
+
+    assert renamed_branch.question_id == "renamed"
+    assert renamed_branch.token_ids == original_branch.token_ids
+    assert renamed_branch.option_end_indices == original_branch.option_end_indices
+
+
+def test_preparation_reports_logical_and_actual_token_usage():
+    tokenizer = CharacterTokenizer()
+    prepared = prepare_request(request(), tokenizer)
+
+    expected_actual = sum(len(question.token_ids) for question in prepared.questions)
+    expected_logical = prepared.state_tokens + sum(
+        len(question.token_ids) - prepared.state_tokens
+        for question in prepared.questions
+    )
+    assert prepared.actual_input_tokens == expected_actual
+    assert prepared.logical_input_tokens == expected_logical
+    assert prepared.actual_input_tokens > prepared.logical_input_tokens
+
+
+def test_last_question_limit_failure_rejects_the_whole_request():
+    tokenizer = CharacterTokenizer()
+    value = request(
+        state="s",
+        questions={
+            "valid": {
+                "type": "choice",
+                "instructions": "x",
+                "criteria": {"a": ""},
+            },
+            "too_long": {
+                "type": "choice",
+                "instructions": "x" * 20,
+                "criteria": {"a": ""},
+            },
+        },
+    )
+
+    with pytest.raises(ValueError, match="too_long.*branch tokens"):
+        prepare_request(value, tokenizer, Limits(max_branch_tokens=15))
+
+
+def test_state_and_logical_limits_use_tokenized_lengths_without_truncation():
+    tokenizer = CharacterTokenizer()
+    value = request(
+        state="abcd",
+        questions={
+            "one": {
+                "type": "choice",
+                "instructions": "x",
+                "criteria": {"a": ""},
+            }
+        },
+    )
+
+    with pytest.raises(ValueError, match="state exceeds 4"):
+        prepare_request(value, tokenizer, Limits(max_state_tokens=4))
+    with pytest.raises(ValueError, match="logical input tokens"):
+        prepare_request(value, tokenizer, Limits(max_logical_tokens=8))
