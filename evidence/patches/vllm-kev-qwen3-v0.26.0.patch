new file mode 100644
index 000000000..2b7781b4f
--- /dev/null
+++ b/vllm/entrypoints/pooling/systemone/renderer.py
@@ -0,0 +1,213 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import re
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any, Protocol
+
+from .protocol import JSONContent, Question, SystemOneRequest
+
+STRUCTURAL_TOKENS = (
+    "<|fim_prefix|>",
+    "<|fim_middle|>",
+    "<|box_start|>",
+    "<|box_end|>",
+    "<|fim_suffix|>",
+)
+_CONTROL_TOKEN = re.compile(r"<\|([A-Za-z0-9_]+)\|>")
+
+
+class Tokenized(Protocol):
+    input_ids: Sequence[int]
+
+
+class Tokenizer(Protocol):
+    def __call__(self, text: str, *, add_special_tokens: bool) -> Tokenized: ...
+
+    def convert_tokens_to_ids(self, token: str) -> int: ...
+
+
+@dataclass(frozen=True)
+class PreparedQuestion:
+    question_id: str
+    question_type: str
+    keys: tuple[str, ...]
+    token_ids: tuple[int, ...]
+    position_ids: tuple[int, ...]
+    option_end_indices: tuple[int, ...]
+    decision_index: int
+    legend: dict[str, str] | None = None
+
+    def metadata(self) -> dict[str, Any]:
+        return {
+            "version": 1,
+            "option_end_indices": list(self.option_end_indices),
+            "decision_index": self.decision_index,
+        }
+
+
+@dataclass(frozen=True)
+class Limits:
+    max_questions: int = 32
+    max_options: int = 255
+    max_state_tokens: int = 8192
+    max_branch_tokens: int = 8192
+    max_logical_tokens: int = 32768
+
+    def __post_init__(self) -> None:
+        if any(
+            value <= 0
+            for value in (
+                self.max_questions,
+                self.max_options,
+                self.max_state_tokens,
+                self.max_branch_tokens,
+                self.max_logical_tokens,
+            )
+        ):
+            raise ValueError("SystemOne limits must be positive")
+
+
+DEFAULT_LIMITS = Limits()
+
+
+@dataclass(frozen=True)
+class PreparedRequest:
+    questions: tuple[PreparedQuestion, ...]
+    state_tokens: int
+    logical_input_tokens: int
+    actual_input_tokens: int
+
+
+def render_json(value: JSONContent, indent: int = 0) -> str:
+    pad = "  " * indent
+    if value is None:
+        return ""
+    if isinstance(value, (str, int, float, bool)):
+        return str(value)
+    if isinstance(value, list):
+        return "\n".join(
+            f"{pad}- {render_json(item, indent + 1).lstrip()}" for item in value
+        )
+    return "\n".join(
+        f"{pad}{key}:\n{render_json(item, indent + 1)}"
+        if isinstance(item, (dict, list))
+        else f"{pad}{key}: {render_json(item)}"
+        for key, item in value.items()
+    )
+
+
+def option_text(name: str, description: JSONContent) -> str:
+    if description is None or description == "":
+        return name
+    return f"{name}: {render_json(description)}"
+
+
+def escape_control_tokens(text: str) -> str:
+    return _CONTROL_TOKEN.sub(r"<¦\1¦>", text)
+
+
+def user_token_ids(tokenizer: Tokenizer, text: str) -> list[int]:
+    encoded = tokenizer(escape_control_tokens(text), add_special_tokens=False)
+    return list(encoded.input_ids)
+
+
+def _question_options(question: Question) -> tuple[list[str], tuple[str, ...]]:
+    if question.type == "noul":
+        criteria = question.criteria or {}
+        options = [
+            option_text("no", criteria.get("false")),
+            option_text("yes", criteria.get("true")),
+        ]
+        return options, ("false", "true")
+    if question.type == "choice":
+        return (
+            [option_text(key, value) for key, value in question.criteria.items()],
+            tuple(question.criteria),
+        )
+    return [render_json(value) for value in question.criteria], tuple(
+        str(index) for index in range(len(question.criteria))
+    )
+
+
+def _structural_token_ids(tokenizer: Tokenizer) -> tuple[int, ...]:
+    token_ids = tuple(
+        tokenizer.convert_tokens_to_ids(token) for token in STRUCTURAL_TOKENS
+    )
+    if any(token_id < 0 for token_id in token_ids) or len(set(token_ids)) != len(
+        token_ids
+    ):
+        raise ValueError("tokenizer has invalid KEV structural token IDs")
+    return token_ids
+
+
+def prepare_questions(
+    request: SystemOneRequest,
+    tokenizer: Tokenizer,
+) -> list[PreparedQuestion]:
+    return list(prepare_request(request, tokenizer).questions)
+
+
+def prepare_request(
+    request: SystemOneRequest,
+    tokenizer: Tokenizer,
+    limits: Limits = DEFAULT_LIMITS,
+) -> PreparedRequest:
+    if len(request.questions) > limits.max_questions:
+        raise ValueError(f"request exceeds {limits.max_questions} questions")
+    state_id, question_id, option_id, option_end_id, decision_id = (
+        _structural_token_ids(tokenizer)
+    )
+    state_tokens = [state_id, *user_token_ids(tokenizer, render_json(request.state))]
+    if len(state_tokens) > limits.max_state_tokens:
+        raise ValueError(f"state exceeds {limits.max_state_tokens} tokens")
+    prepared = []
+    for external_id, question in request.questions.items():
+        options, keys = _question_options(question)
+        if len(options) > limits.max_options:
+            raise ValueError(
+                f"question {external_id!r} exceeds {limits.max_options} options"
+            )
+        token_ids = [
+            *state_tokens,
+            question_id,
+            *user_token_ids(tokenizer, render_json(question.instructions)),
+        ]
+        option_end_indices = []
+        for option in options:
+            token_ids.extend(
+                [option_id, *user_token_ids(tokenizer, option), option_end_id]
+            )
+            option_end_indices.append(len(token_ids) - 1)
+        token_ids.append(decision_id)
+        if len(token_ids) > limits.max_branch_tokens:
+            raise ValueError(
+                f"question {external_id!r} exceeds "
+                f"{limits.max_branch_tokens} branch tokens"
+            )
+        legend = dict(zip(keys, options)) if question.type == "score" else None
+        prepared.append(
+            PreparedQuestion(
+                question_id=external_id,
+                question_type=question.type,
+                keys=keys,
+                token_ids=tuple(token_ids),
+                position_ids=tuple(range(len(token_ids))),
+                option_end_indices=tuple(option_end_indices),
+                decision_index=len(token_ids) - 1,
+                legend=legend,
+            )
+        )
+    logical_input_tokens = len(state_tokens) + sum(
+        len(question.token_ids) - len(state_tokens) for question in prepared
+    )
+    if logical_input_tokens > limits.max_logical_tokens:
+        raise ValueError(
+            f"request exceeds {limits.max_logical_tokens} logical input tokens"
+        )
+    return PreparedRequest(
+        questions=tuple(prepared),
+        state_tokens=len(state_tokens),
+        logical_input_tokens=logical_input_tokens,
+        actual_input_tokens=sum(len(question.token_ids) for question in prepared),
+    )
