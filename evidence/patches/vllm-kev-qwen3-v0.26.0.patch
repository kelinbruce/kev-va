+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.model_executor.models import (
+    is_pooling_model,
+    is_text_generation_model,
+    kev_qwen3,
+)
+from vllm.model_executor.models.registry import ModelRegistry
+
+
+def test_kev_qwen3_is_registered_as_decision_only_pooling_model():
+    model_cls = ModelRegistry._try_load_model_cls("KevQwen3ForDecision")
+    assert model_cls is not None
+    assert is_pooling_model(model_cls)
+    assert not is_text_generation_model(model_cls)
+
+
+class Backbone(nn.Module):
+    def __init__(self, **kwargs):
+        super().__init__()
+        self.make_empty_intermediate_tensors = lambda: None
+
+    def embed_input_ids(self, input_ids):
+        return input_ids
+
+    def forward(self, input_ids, positions, intermediate_tensors, inputs_embeds):
+        return inputs_embeds if inputs_embeds is not None else input_ids
+
+
+def config(**head):
+    hf_config = SimpleNamespace(
+        hidden_size=8,
+        kev_backbone_dtype="bfloat16",
+        **head,
+    )
+    return SimpleNamespace(
+        model_config=SimpleNamespace(
+            hf_config=hf_config,
+            dtype=torch.bfloat16,
+            enforce_eager=True,
+        ),
+        parallel_config=SimpleNamespace(
+            tensor_parallel_size=1,
+            pipeline_parallel_size=1,
+        ),
+        cache_config=SimpleNamespace(enable_prefix_caching=False),
+        scheduler_config=SimpleNamespace(
+            enable_chunked_prefill=False,
+            max_num_batched_tokens=8192,
+        ),
+        quant_config=None,
+        lora_config=None,
+    )
+
+
+def test_kev_model_builds_backbone_and_fp32_head_without_generation(monkeypatch):
+    monkeypatch.setattr(kev_qwen3, "Qwen3Model", Backbone)
+    model = kev_qwen3.KevQwen3ForDecision(
+        vllm_config=config(kev_head_dim=3, kev_temperature=0.75)
+    )
+
+    assert not hasattr(model, "lm_head")
+    assert not hasattr(model, "compute_logits")
+    assert model.pooler.q.weight.dtype == torch.float32
+    assert model.pooler.k.bias.dtype == torch.float32
+    assert model.pooler.temperature == 0.75
+    assert model.pooler.get_supported_tasks() == {"plugin"}
+
+
+@pytest.mark.parametrize(
+    "head,match",
+    [
+        ({"kev_temperature": 1.0}, "head_dim"),
+        ({"kev_head_dim": 3}, "temperature"),
+        ({"kev_head_dim": 0, "kev_temperature": 1.0}, "head_dim"),
+        ({"kev_head_dim": 3, "kev_temperature": float("nan")}, "temperature"),
+    ],
+)
+def test_kev_model_rejects_missing_or_invalid_head_config(monkeypatch, head, match):
+    monkeypatch.setattr(kev_qwen3, "Qwen3Model", Backbone)
+    with pytest.raises(ValueError, match=match):
+        kev_qwen3.KevQwen3ForDecision(vllm_config=config(**head))
+
+
+@pytest.mark.parametrize(
+    "path,value,match",
+    [
+        (("model_config", "enforce_eager"), False, "eager"),
+        (("parallel_config", "tensor_parallel_size"), 2, "TP=1"),
+        (("cache_config", "enable_prefix_caching"), True, "prefix caching"),
+        (("scheduler_config", "enable_chunked_prefill"), True, "chunked"),
+        (("scheduler_config", "max_num_batched_tokens"), 8191, "complete"),
+        (("quant_config",), object(), "quantization"),
+        (("lora_config",), object(), "runtime LoRA"),
+    ],
+)
+def test_kev_runtime_profile_rejects_unsupported_modes(path, value, match):
+    vllm_config = config(kev_head_dim=3, kev_temperature=1.0)
+    target = vllm_config
+    for part in path[:-1]:
+        target = getattr(target, part)
+    setattr(target, path[-1], value)
+    with pytest.raises(ValueError, match=match):
+        kev_qwen3.validate_kev_runtime_config(vllm_config)
+
+
+def test_kev_runtime_profile_requires_explicit_matching_dtype():
+    vllm_config = config(kev_head_dim=3, kev_temperature=1.0)
+    vllm_config.model_config.hf_config.kev_backbone_dtype = "float16"
+    with pytest.raises(ValueError, match="explicit matching"):
+        kev_qwen3.validate_kev_runtime_config(vllm_config)
